38851>>>    Procedure SetActionButtons
38854>>>        tWebNavigateData NavigateData
38854>>>        tWebNavigateData NavigateData
38854>>>        Boolean bHasRecord
38854>>>        Handle hoDD
38854>>>
38854>>>        Get Server to hoDD
38855>>>        Get GetNavigateData to NavigateData
38856>>>        Get HasRecord of hoDD to bHasRecord
38857>>>
38857>>>        // let's hide all buttons and then Show the ones we want
38857>>>        WebSet pbRender of oEditBtn to False
38858>>>        WebSet pbRender of oSaveBtn to False
38859>>>        WebSet pbRender of oCancelChangesBtn to False
38860>>>        WebSet pbRender of oDeleteBtn to False
38861>>>
38861>>>        If (NavigateData.bReadOnly) Begin
38863>>>            WebSet pbRender of oEditBtn to True
38864>>>        End
38864>>>>
38864>>>        Else Begin
38865>>>            WebSet pbRender of oSaveBtn to True
38866>>>            WebSet pbRender of oCancelChangesBtn to True
38867>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38868>>>        End
38868>>>>
38868>>>    End_Procedure
