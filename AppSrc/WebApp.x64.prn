39780>>>    Procedure CrearCentro Boolean bCreate String sKey
39783>>>        Handle hoJson
39783>>>        Boolean bSuccess
39783>>>        String sVal
39783>>>        Boolean bVal bErr
39783>>>        
39783>>>        //  Find the right record
39783>>>        If (bCreate) Begin
39785>>>            Send Clear of oCentros_DD
39786>>>        End
39786>>>>
39786>>>        Else Begin
39787>>>            Send Clear of oCentros_DD
39788>>>            Move sKey to Centros.Id
39789>>>            Send Find of oCentros_DD EQ 1
39790>>>            
39790>>>            If (not(Found)) Begin
39792>>>                Send SetResponseStatus 404 "Resource not found"
39793>>>                Procedure_Return
39794>>>            End
39794>>>>
39794>>>        End
39794>>>>
39794>>>        
39794>>>        //  Read the request data
39794>>>        Get RequestDataJson (&hoJson) to bSuccess
39795>>>        
39795>>>        If (bSuccess) Begin
39797>>>            Send ErrorQueueStart
39798>>>            
39798>>>            //  Set the values
39798>>>            If (HasMember(hoJson, "Nombre")) Begin
39800>>>                Get MemberValue of hoJson "Nombre" to sVal
39801>>>                Set Field_Changed_Value of oCentros_DD (RefTable(Centros.Nombre)) to sVal
39802>>>            End
39802>>>>
39802>>>            
39802>>>            If (HasMember(hoJson, "PsNombre")) Begin
39804>>>                Get MemberValue of hoJson "PsNombre" to sVal
39805>>>                Set Field_Changed_Value of oCentros_DD (RefTable(Centros.PsNombre)) to sVal
39806>>>            End
39806>>>>
39806>>>            
39806>>>            
39806>>>            If (HasMember(hoJson, "Direccion")) Begin
39808>>>                Get MemberValue of hoJson "Direccion" to sVal
39809>>>                Set Field_Changed_Value of oCentros_DD (RefTable(Centros.Direccion)) to sVal
39810>>>            End
39810>>>>
39810>>>            
39810>>>            If (HasMember(hoJson, "Pais")) Begin
39812>>>                Get MemberValue of hoJson "Pais" to sVal
39813>>>                Set Field_Changed_Value of oCentros_DD (RefTable(Centros.Pais)) to sVal
39814>>>            End
39814>>>>
39814>>>            
39814>>>            If (HasMember(hoJson, "ComunidadAutonoma")) Begin
39816>>>                Get MemberValue of hoJson "ComunidadAutonoma" to sVal
39817>>>                Set Field_Changed_Value of oCentros_DD (RefTable(Centros.ComunidadAutonoma)) to sVal
39818>>>            End
39818>>>>
39818>>>            
39818>>>            If (HasMember(hoJson, "Localidad")) Begin
39820>>>                Get MemberValue of hoJson "Localidad" to sVal
39821>>>                Set Field_Changed_Value of oCentros_DD (RefTable(Centros.Localidad)) to sVal
39822>>>            End
39822>>>>
39822>>>            
39822>>>            If (HasMember(hoJson, "CodigoPostal")) Begin
39824>>>                Get MemberValue of hoJson "CodigoPostal" to sVal
39825>>>                Set Field_Changed_Value of oCentros_DD (RefTable(Centros.CodigoPostal)) to sVal
39826>>>            End
39826>>>>
39826>>>            
39826>>>            If (HasMember(hoJson, "Empresa")) Begin
39828>>>                Get MemberValue of hoJson "Empresa" to sVal
39829>>>                Set Field_Changed_Value of oCentros_DD (RefTable(Centros.Empresa)) to sVal
39830>>>            End
39830>>>>
39830>>>            
39830>>>            //  Perform the save
39830>>>            If (ErrorCount(Self) = 0) Begin
39832>>>                Get Request_Validate of oCentros_DD to bErr
39833>>>                If (not(bErr)) Begin
