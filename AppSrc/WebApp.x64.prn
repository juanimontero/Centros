36674>>>>>>>    //
36674>>>>>>>    //  Converts the given time to an string that can be saved in the database.
36674>>>>>>>    //
36674>>>>>>>    //  Params:
36674>>>>>>>    //      dtTime  Time to convert
36674>>>>>>>    //  Returns:
36674>>>>>>>    //      String with "HH:MM:SS" format
36674>>>>>>>    //
36674>>>>>>>    Function TimeToString DateTime dtTime Returns String
36676>>>>>>>        String sHours sMinutes sSeconds
36676>>>>>>>        
36676>>>>>>>        //  Extract parts
36676>>>>>>>        Move (String(DateGetHour(dtTime))) to sHours
36677>>>>>>>        Move (String(DateGetMinute(dtTime))) to sMinutes
36678>>>>>>>        Move (String(DateGetSecond(dtTime))) to sSeconds
36679>>>>>>>        
36679>>>>>>>        //  Fill out with 0
36679>>>>>>>        If (Length(sHours) = 1) ;            Move ("0" + sHours) to sHours
36682>>>>>>>        If (Length(sMinutes) = 1) ;            Move ("0" + sMinutes) to sMinutes
36685>>>>>>>        If (Length(sSeconds) = 1) ;            Move ("0" + sSeconds) to sSeconds
36688>>>>>>>        
36688>>>>>>>        Function_Return (sHours + ":" + sMinutes + ":" + sSeconds)
36689>>>>>>>    End_Function
36690>>>>>>>    
36690>>>>>>>    //
36690>>>>>>>    //  Sets the time of the datetime variable to the time in the string.
36690>>>>>>>    //
36690>>>>>>>    //  Params:
36690>>>>>>>    //      dtTime  Datetime variable to add time to
36690>>>>>>>    //      sTimeString String with time in the format "HH:MM:SS"
36690>>>>>>>    //  Returns:
36690>>>>>>>    //      dtDateTime with the loaded time
36690>>>>>>>    //
36690>>>>>>>    Function StringToTime DateTime dtTime String sTimeString Returns DateTime
36692>>>>>>>        String sHours sMinutes sSeconds
36692>>>>>>>        
36692>>>>>>>        //  Extract parts
36692>>>>>>>        Move (Mid(sTimeString, 2, 1)) to sHours
36693>>>>>>>        Move (Mid(sTimeString, 2, 4)) to sMinutes
36694>>>>>>>        Move (Mid(sTimeString, 2, 7)) to sSeconds
36695>>>>>>>        
36695>>>>>>>        //  Set to DateTime
36695>>>>>>>        Move (DateSetHour(dtTime, (Integer(sHours)))) to dtTime
36696>>>>>>>        Move (DateSetMinute(dtTime, (Integer(sMinutes)))) to dtTime
36697>>>>>>>        Move (DateSetSecond(dtTime, (Integer(sSeconds)))) to dtTime
36698>>>>>>>        
36698>>>>>>>        Function_Return dtTime
36699>>>>>>>    End_Function
36700>>>>>>>End_Class
