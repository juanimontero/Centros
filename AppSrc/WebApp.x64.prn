38156>>>>>>>>>>>Class cHttpTransfer is a cBaseHttpTransfer
38157>>>>>>>>>>>    
38157>>>>>>>>>>>    Function HttpPostRequest String sFilePath String sData Integer bDataIsFile Returns Integer
38159>>>>>>>>>>>        Integer bStat
38159>>>>>>>>>>>        Get HttpPostAddrRequest sFilePath (AddressOf(sData)) (SizeOfString(sData)) bDataIsfile to bStat
38160>>>>>>>>>>>        Function_Return bStat
38161>>>>>>>>>>>    End_Function
38162>>>>>>>>>>>    
38162>>>>>>>>>>>    // This event is triggered from the runtime. It now uses UChar arrays as the data might 
38162>>>>>>>>>>>    // not be a valid string (it can be any binary data). It still calls the original event for 
38162>>>>>>>>>>>    // backwards compatibility.
38162>>>>>>>>>>>    Procedure OnDataReceivedUC String sContentType UChar[] ucData
38164>>>>>>>>>>>        Send OnDataReceived sContentType (UCharArrayToString(ucData))
38165>>>>>>>>>>>    End_Procedure
38166>>>>>>>>>>>    
38166>>>>>>>>>>>    // Only use this event if you know for sure the data is a string and make sure piBufferSize is
38166>>>>>>>>>>>    // smaller than the argument size.
38166>>>>>>>>>>>    Procedure OnDataReceived String sContentType String sData
38168>>>>>>>>>>>        
38168>>>>>>>>>>>    End_Procedure
38169>>>>>>>>>>>    
38169>>>>>>>>>>>    // Called just before the request is sent. Use this message to set options to the RequestHandle if nessecary.
38169>>>>>>>>>>>    Procedure OnPreSendRequest 
38171>>>>>>>>>>>        
38171>>>>>>>>>>>    End_Procedure
38172>>>>>>>>>>>    
38172>>>>>>>>>>>    Function HttpPutRequest String sFilePath String sData Integer bDataIsFile Returns Integer
38174>>>>>>>>>>>        Integer bStat
38174>>>>>>>>>>>        Get HttpPutAddrRequest sFilePath (AddressOf(sData)) (SizeOfString(sData)) bDataIsfile to bStat
38175>>>>>>>>>>>        Function_Return bStat
38176>>>>>>>>>>>    End_Function
38177>>>>>>>>>>>    
38177>>>>>>>>>>>    // Retrieve header information associated with the previous request.
38177>>>>>>>>>>>    Function QueryInfo DWord dwInfoLevel Returns String
38179>>>>>>>>>>>        Handle hRequestHandle
38179>>>>>>>>>>>        WString wResult
38179>>>>>>>>>>>        Integer iBufferSize iRes iVoid
38179>>>>>>>>>>>
38179>>>>>>>>>>>        Get RequestHandle to hRequestHandle
38180>>>>>>>>>>>        
38180>>>>>>>>>>>        If (hRequestHandle) Begin
38182>>>>>>>>>>>            Move 200 to iBufferSize
38183>>>>>>>>>>>            Move (Repeat(" ", iBufferSize)) to wResult
38184>>>>>>>>>>>            Move (WinAPI_HttpQueryInfo(hRequestHandle, dwInfoLevel, AddressOf(wResult), AddressOf(iBufferSize), 0)) to iRes
38185>>>>>>>>>>>            
38185>>>>>>>>>>>            If (not(iRes) and GetLastError() = 122) Begin //  Insufficient buffersize, retry with received iBufferSize value
38187>>>>>>>>>>>                Increment iBufferSize      
38188>>>>>>>>>>>                
38188>>>>>>>>>>>                Move (Repeat(" ", iBufferSize)) to wResult
38189>>>>>>>>>>>                Move (WinAPI_HttpQueryInfo(hRequestHandle, dwInfoLevel, AddressOf(wResult), AddressOf(iBufferSize), 0)) to iRes  
38190>>>>>>>>>>>            End
38190>>>>>>>>>>>>
38190>>>>>>>>>>>            
38190>>>>>>>>>>>            If (not(iRes)) Begin
38192>>>>>>>>>>>                Move (ShowLastError()) to iVoid
38193>>>>>>>>>>>            End
38193>>>>>>>>>>>>
38193>>>>>>>>>>>        End
38193>>>>>>>>>>>>
38193>>>>>>>>>>>        
38193>>>>>>>>>>>        Function_Return (CString(wResult))
38194>>>>>>>>>>>    End_Function
38195>>>>>>>>>>>    
38195>>>>>>>>>>>    // Returns the statustext returned by the previous request.
38195>>>>>>>>>>>    Function ResponseStatusText Returns String
38197>>>>>>>>>>>        String sStatus
38197>>>>>>>>>>>        
38197>>>>>>>>>>>        Get QueryInfo HTTP_QUERY_STATUS_TEXT to sStatus
38198>>>>>>>>>>>        
38198>>>>>>>>>>>        Function_Return sStatus
38199>>>>>>>>>>>    End_Function
38200>>>>>>>>>>>    
38200>>>>>>>>>>>End_Class
