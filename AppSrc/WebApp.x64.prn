38155>>>>>>>>>>>Class cHttpTransfer is a cBaseHttpTransfer
38156>>>>>>>>>>>    
38156>>>>>>>>>>>    Function HttpPostRequest String sFilePath String sData Integer bDataIsFile Returns Integer
38158>>>>>>>>>>>        Integer bStat
38158>>>>>>>>>>>        Get HttpPostAddrRequest sFilePath (AddressOf(sData)) (SizeOfString(sData)) bDataIsfile to bStat
38159>>>>>>>>>>>        Function_Return bStat
38160>>>>>>>>>>>    End_Function
38161>>>>>>>>>>>    
38161>>>>>>>>>>>    // This event is triggered from the runtime. It now uses UChar arrays as the data might 
38161>>>>>>>>>>>    // not be a valid string (it can be any binary data). It still calls the original event for 
38161>>>>>>>>>>>    // backwards compatibility.
38161>>>>>>>>>>>    Procedure OnDataReceivedUC String sContentType UChar[] ucData
38163>>>>>>>>>>>        Send OnDataReceived sContentType (UCharArrayToString(ucData))
38164>>>>>>>>>>>    End_Procedure
38165>>>>>>>>>>>    
38165>>>>>>>>>>>    // Only use this event if you know for sure the data is a string and make sure piBufferSize is
38165>>>>>>>>>>>    // smaller than the argument size.
38165>>>>>>>>>>>    Procedure OnDataReceived String sContentType String sData
38167>>>>>>>>>>>        
38167>>>>>>>>>>>    End_Procedure
38168>>>>>>>>>>>    
38168>>>>>>>>>>>    // Called just before the request is sent. Use this message to set options to the RequestHandle if nessecary.
38168>>>>>>>>>>>    Procedure OnPreSendRequest 
38170>>>>>>>>>>>        
38170>>>>>>>>>>>    End_Procedure
38171>>>>>>>>>>>    
38171>>>>>>>>>>>    Function HttpPutRequest String sFilePath String sData Integer bDataIsFile Returns Integer
38173>>>>>>>>>>>        Integer bStat
38173>>>>>>>>>>>        Get HttpPutAddrRequest sFilePath (AddressOf(sData)) (SizeOfString(sData)) bDataIsfile to bStat
38174>>>>>>>>>>>        Function_Return bStat
38175>>>>>>>>>>>    End_Function
38176>>>>>>>>>>>    
38176>>>>>>>>>>>    // Retrieve header information associated with the previous request.
38176>>>>>>>>>>>    Function QueryInfo DWord dwInfoLevel Returns String
38178>>>>>>>>>>>        Handle hRequestHandle
38178>>>>>>>>>>>        WString wResult
38178>>>>>>>>>>>        Integer iBufferSize iRes iVoid
38178>>>>>>>>>>>
38178>>>>>>>>>>>        Get RequestHandle to hRequestHandle
38179>>>>>>>>>>>        
38179>>>>>>>>>>>        If (hRequestHandle) Begin
38181>>>>>>>>>>>            Move 200 to iBufferSize
38182>>>>>>>>>>>            Move (Repeat(" ", iBufferSize)) to wResult
38183>>>>>>>>>>>            Move (WinAPI_HttpQueryInfo(hRequestHandle, dwInfoLevel, AddressOf(wResult), AddressOf(iBufferSize), 0)) to iRes
38184>>>>>>>>>>>            
38184>>>>>>>>>>>            If (not(iRes) and GetLastError() = 122) Begin //  Insufficient buffersize, retry with received iBufferSize value
38186>>>>>>>>>>>                Increment iBufferSize      
38187>>>>>>>>>>>                
38187>>>>>>>>>>>                Move (Repeat(" ", iBufferSize)) to wResult
38188>>>>>>>>>>>                Move (WinAPI_HttpQueryInfo(hRequestHandle, dwInfoLevel, AddressOf(wResult), AddressOf(iBufferSize), 0)) to iRes  
38189>>>>>>>>>>>            End
38189>>>>>>>>>>>>
38189>>>>>>>>>>>            
38189>>>>>>>>>>>            If (not(iRes)) Begin
38191>>>>>>>>>>>                Move (ShowLastError()) to iVoid
38192>>>>>>>>>>>            End
38192>>>>>>>>>>>>
38192>>>>>>>>>>>        End
38192>>>>>>>>>>>>
38192>>>>>>>>>>>        
38192>>>>>>>>>>>        Function_Return (CString(wResult))
38193>>>>>>>>>>>    End_Function
38194>>>>>>>>>>>    
38194>>>>>>>>>>>    // Returns the statustext returned by the previous request.
38194>>>>>>>>>>>    Function ResponseStatusText Returns String
38196>>>>>>>>>>>        String sStatus
38196>>>>>>>>>>>        
38196>>>>>>>>>>>        Get QueryInfo HTTP_QUERY_STATUS_TEXT to sStatus
38197>>>>>>>>>>>        
38197>>>>>>>>>>>        Function_Return sStatus
38198>>>>>>>>>>>    End_Function
38199>>>>>>>>>>>    
38199>>>>>>>>>>>End_Class
