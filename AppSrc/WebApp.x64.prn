39726>>>    Procedure ListaCentros
39729>>>        Handle hoJson hoCentro
39729>>>
39729>>>        Get Create (RefClass(cJsonObject)) to hoJson
39730>>>        Send InitializeJsonType of hoJson jsonTypeArray
39731>>>
39731>>>        Get Create (RefClass(cJsonObject)) to hoCentro
39732>>>
39732>>>        Send Find of oCentros_DD FIRST_RECORD 1
39733>>>        While (Found)
39737>>>            Send InitializeJsonType of hoCentro jsonTypeObject
39738>>>
39738>>>            Send SetMemberValue of hoCentro "Id" jsonTypeInteger Centros.Id
39739>>>            Send SetMemberValue of hoCentro "Nombre" jsonTypeString Centros.Nombre
39740>>>            Send SetMemberValue of hoCentro "PsNombre" jsonTypeString Centros.PsNombre
39741>>>            Send AddMember of hoJson hoCentro
39742>>>
39742>>>            Send Find of oCentros_DD NEXT_RECORD 1
39743>>>        Loop
39744>>>>
39744>>>
39744>>>        Send OutputJson hoJson
39745>>>
39745>>>        Send Destroy of hoCentro
39746>>>        Send Destroy of hoJson
39747>>>    End_Procedure
39748>>>
39748>>>    Procedure OutputJson Handle hoJson
39751>>>        UChar[] ucData
39752>>>
39752>>>        Send AddHttpResponseHeader "Content-Type" "application/json"
39753>>>        Get StringifyUtf8 of hoJson to ucData
39754>>>        Send OutputUChar ucData
39755>>>    End_Procedure
39756>>>    
39756>>>    Procedure listarporid Integer iId
39759>>>        Handle hoJson
39759>>>        
39759>>>        Send Clear of oCentros_DD
39760>>>        Move iId to Centros.Id
39761>>>        Send Find of oCentros_DD EQ 1
39762>>>        
39762>>>        If (Found) Begin
39764>>>            Get Create (RefClass(cJsonObject)) to hoJson
39765>>>            Send InitializeJsonType of hoJson jsonTypeObject
39766>>>            
39766>>>             Send SetMemberValue of hoJson "Id" jsonTypeInteger Centros.Id
39767>>>             Send SetMemberValue of hoJson "Nombre" jsonTypeString Centros.Nombre
39768>>>             Send SetMemberValue of hoJson "PsNombre" jsonTypeString Centros.PsNombre
39769>>>             Send SetMemberValue of hoJson "Direccion" jsonTypeString Centros.Direccion
39770>>>             Send SetMemberValue of hoJson "Pais" jsonTypeString Centros.Pais
39771>>>             Send SetMemberValue of hoJson "ComunidadAutonoma" jsonTypeString Centros.ComunidadAutonoma
39772>>>             Send SetMemberValue of hoJson "Localidad" jsonTypeString Centros.Localidad
39773>>>             Send SetMemberValue of hoJson "CodigoPostal" jsonTypeInteger Centros.CodigoPostal
39774>>>             Send SetMemberValue of hoJson "Empresa" jsonTypeString Centros.Empresa
39775>>>//             Send SetMemberValue of hoJson "FechaCreacionRegistro" jsonTypeString Centros.FechaCreacionRegistro
39775>>>//             Send SetMemberValue of hoJson "FechaUltimaModificacion" jsonTypeString Centros.FechaUltimaModificacion
39775>>>            
39775>>>            Send OutputJson hoJson
39776>>>            Send Destroy of hoJson
39777>>>        End
39777>>>>
39777>>>        Else Begin
39778>>>            Send SetResponseStatus 404 "Resource not found"
39779>>>        End
39779>>>>
39779>>>    End_Procedure
