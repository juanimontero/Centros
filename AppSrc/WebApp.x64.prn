39740>>>            If (HasMember(hoJson, "Nombre")) Begin
39742>>>                Get MemberValue of hoJson "Nombre" to sVal
39743>>>                Set Field_Changed_Value of oCentros_DD (RefTable(Centros.Nombre)) to sVal
39744>>>            End
39744>>>>
39744>>>            
39744>>>            If (HasMember(hoJson, "PsNombre")) Begin
39746>>>                Get MemberValue of hoJson "PsNombre" to sVal
39747>>>                Set Field_Changed_Value of oCentros_DD (RefTable(Centros.PsNombre)) to sVal
39748>>>            End
39748>>>>
39748>>>            
39748>>>            
39748>>>            If (HasMember(hoJson, "Direccion")) Begin
39750>>>                Get MemberValue of hoJson "Direccion" to sVal
39751>>>                Set Field_Changed_Value of oCentros_DD (RefTable(Centros.Direccion)) to sVal
39752>>>            End
39752>>>>
39752>>>            
39752>>>            If (HasMember(hoJson, "Pais")) Begin
39754>>>                Get MemberValue of hoJson "Pais" to sVal
39755>>>                Set Field_Changed_Value of oCentros_DD (RefTable(Centros.Pais)) to sVal
39756>>>            End
