37174>>>>>    Function UserLogin String sLoginName String sPassword Returns Boolean
37176>>>>>        String sSessionKey sUserPassword
37176>>>>>        Handle hoSessionDD hoUserDD
37176>>>>>        Boolean bMatch bUpgrade
37176>>>>>        
37176>>>>>        Get phoSessionDD to hoSessionDD
37177>>>>>        Get phoUserDD to hoUserDD
37178>>>>>        Integer iErr eLoginMode
37178>>>>>        
37178>>>>>        // Refind session record
37178>>>>>        Get psSessionKey to sSessionKey
37179>>>>>        Send Clear of hoSessionDD
37180>>>>>        Move sSessionKey to WebAppSession.SessionKey
37181>>>>>        Send Find of hoSessionDD EQ Index.1
37182>>>>>        
37182>>>>>        If (Found and WebAppSession.SessionKey = sSessionKey) Begin
37184>>>>>            Get peLoginMode to eLoginMode
37185>>>>>            
37185>>>>>            //  Find the user
37185>>>>>            Move sLoginName to WebAppUser.LoginName
37186>>>>>            Send Find of hoUserDD EQ Index.1
37187>>>>>            
37187>>>>>            // Check username and password
37187>>>>>            If (Found and (Lowercase(sLoginName) = Lowercase(Trim(WebAppUser.LoginName)))) Begin
37189>>>>>                Get Field_Current_Value of hoUserDD Field WebAppUser.Password to sUserPassword
37190>>>>>                Get VerifyPasswordHash (Trim(sUserPassword)) (Trim(sPassword)) (&bUpgrade) to bMatch
37191>>>>>                
37191>>>>>                If (bMatch) Begin
37193>>>>>                    // Store the login
37193>>>>>                    If (bUpgrade) Begin
37195>>>>>                        Get CreatePasswordHash (Trim(sPassword)) (&sPassword) to bUpgrade
37196>>>>>                        If (bUpgrade) Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37199>>>>>                    End
37199>>>>>>
37199>>>>>                    Set Field_Changed_Value of hoUserDD Field WebAppUser.LastLogin to (CurrentDateTime())
37200>>>>>                    Get Request_Validate of hoSessionDD to iErr
37201>>>>>                    If (iErr) Begin
37203>>>>>                        // this should not happen. If it does its a programming error
37203>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37204>>>>>>
37204>>>>>                        Function_Return False
37205>>>>>                    End
37205>>>>>>
37205>>>>>                    
37205>>>>>                    Send Request_Save of hoSessionDD
37206>>>>>                    
37206>>>>>                    // Update session properties
37206>>>>>                    Send UpdateSessionProperties False
37207>>>>>                    Send NotifyChangeRights
37208>>>>>                    Function_Return True
37209>>>>>                End
37209>>>>>>
37209>>>>>                Else Begin
37210>>>>>                    //  We should rely directly on this buffer elsewhere but just be sure
37210>>>>>                    Send Clear of hoUserDD
37211>>>>>                End
37211>>>>>>
37211>>>>>            End
37211>>>>>>
37211>>>>>            Else Begin
37212>>>>>                // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37212>>>>>                Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37213>>>>>            End
37213>>>>>>
37213>>>>>        End
37213>>>>>>
37213>>>>>        Else Begin
37214>>>>>            // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37214>>>>>            Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37215>>>>>        End
37215>>>>>>
37215>>>>>          
37215>>>>>        Function_Return False
37216>>>>>    End_Function
