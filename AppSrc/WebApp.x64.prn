36673>>>>>>>    
36673>>>>>>>    //
36673>>>>>>>    //  Converts the given time to an string that can be saved in the database.
36673>>>>>>>    //
36673>>>>>>>    //  Params:
36673>>>>>>>    //      dtTime  Time to convert
36673>>>>>>>    //  Returns:
36673>>>>>>>    //      String with "HH:MM:SS" format
36673>>>>>>>    //
36673>>>>>>>    Function TimeToString DateTime dtTime Returns String
36675>>>>>>>        String sHours sMinutes sSeconds
36675>>>>>>>        
36675>>>>>>>        //  Extract parts
36675>>>>>>>        Move (String(DateGetHour(dtTime))) to sHours
36676>>>>>>>        Move (String(DateGetMinute(dtTime))) to sMinutes
36677>>>>>>>        Move (String(DateGetSecond(dtTime))) to sSeconds
36678>>>>>>>        
36678>>>>>>>        //  Fill out with 0
36678>>>>>>>        If (Length(sHours) = 1) ;            Move ("0" + sHours) to sHours
36681>>>>>>>        If (Length(sMinutes) = 1) ;            Move ("0" + sMinutes) to sMinutes
36684>>>>>>>        If (Length(sSeconds) = 1) ;            Move ("0" + sSeconds) to sSeconds
36687>>>>>>>        
36687>>>>>>>        Function_Return (sHours + ":" + sMinutes + ":" + sSeconds)
36688>>>>>>>    End_Function
36689>>>>>>>    
36689>>>>>>>    //
36689>>>>>>>    //  Sets the time of the datetime variable to the time in the string.
36689>>>>>>>    //
36689>>>>>>>    //  Params:
36689>>>>>>>    //      dtTime  Datetime variable to add time to
36689>>>>>>>    //      sTimeString String with time in the format "HH:MM:SS"
36689>>>>>>>    //  Returns:
36689>>>>>>>    //      dtDateTime with the loaded time
36689>>>>>>>    //
36689>>>>>>>    Function StringToTime DateTime dtTime String sTimeString Returns DateTime
36691>>>>>>>        String sHours sMinutes sSeconds
36691>>>>>>>        
36691>>>>>>>        //  Extract parts
36691>>>>>>>        Move (Mid(sTimeString, 2, 1)) to sHours
36692>>>>>>>        Move (Mid(sTimeString, 2, 4)) to sMinutes
36693>>>>>>>        Move (Mid(sTimeString, 2, 7)) to sSeconds
36694>>>>>>>        
36694>>>>>>>        //  Set to DateTime
36694>>>>>>>        Move (DateSetHour(dtTime, (Integer(sHours)))) to dtTime
36695>>>>>>>        Move (DateSetMinute(dtTime, (Integer(sMinutes)))) to dtTime
36696>>>>>>>        Move (DateSetSecond(dtTime, (Integer(sSeconds)))) to dtTime
36697>>>>>>>        
36697>>>>>>>        Function_Return dtTime
36698>>>>>>>    End_Function
36699>>>>>>>End_Class
