39722>>>    Procedure CrearCentro Boolean bCreate String sKey
39725>>>        Handle hoJson
39725>>>        Boolean bSuccess
39725>>>        String sVal
39725>>>        Boolean bVal bErr
39725>>>        
39725>>>        //  Find the right record
39725>>>        If (bCreate) Begin
39727>>>            Send Clear of oCentros_DD
39728>>>        End
39728>>>>
39728>>>        Else Begin
39729>>>            Send Clear of oCentros_DD
39730>>>            Move sKey to Centros.Id
39731>>>            Send Find of oCentros_DD EQ 1
39732>>>            
39732>>>            If (not(Found)) Begin
39734>>>                Send SetResponseStatus 404 "Resource not found"
39735>>>                Procedure_Return
39736>>>            End
39736>>>>
39736>>>        End
39736>>>>
39736>>>        
39736>>>        //  Read the request data
