39734>>>    Procedure ListaCentros
39737>>>        Handle hoJson hoCentro
39737>>>
39737>>>        Get Create (RefClass(cJsonObject)) to hoJson
39738>>>        Send InitializeJsonType of hoJson jsonTypeArray
39739>>>
39739>>>        Get Create (RefClass(cJsonObject)) to hoCentro
39740>>>
39740>>>        Send Find of oCentros_DD FIRST_RECORD 1
39741>>>        While (Found)
39745>>>            Send InitializeJsonType of hoCentro jsonTypeObject
39746>>>
39746>>>            Send SetMemberValue of hoCentro "Id" jsonTypeInteger Centros.Id
39747>>>            Send SetMemberValue of hoCentro "Nombre" jsonTypeString Centros.Nombre
39748>>>            Send SetMemberValue of hoCentro "PsNombre" jsonTypeString Centros.PsNombre
39749>>>            Send AddMember of hoJson hoCentro
39750>>>
39750>>>            Send Find of oCentros_DD NEXT_RECORD 1
39751>>>        Loop
39752>>>>
39752>>>
39752>>>        Send OutputJson hoJson
39753>>>
39753>>>        Send Destroy of hoCentro
39754>>>        Send Destroy of hoJson
39755>>>    End_Procedure
39756>>>
39756>>>    Procedure OutputJson Handle hoJson
39759>>>        UChar[] ucData
39760>>>
39760>>>        Send AddHttpResponseHeader "Content-Type" "application/json"
39761>>>        Get StringifyUtf8 of hoJson to ucData
39762>>>        Send OutputUChar ucData
39763>>>    End_Procedure
39764>>>    
39764>>>    Procedure listarporid Integer iId
39767>>>        Handle hoJson
39767>>>        
39767>>>        Send Clear of oCentros_DD
39768>>>        Move iId to Centros.Id
39769>>>        Send Find of oCentros_DD EQ 1
39770>>>        
39770>>>        If (Found) Begin
39772>>>            Get Create (RefClass(cJsonObject)) to hoJson
39773>>>            Send InitializeJsonType of hoJson jsonTypeObject
39774>>>            
39774>>>             Send SetMemberValue of hoJson "Id" jsonTypeInteger Centros.Id
39775>>>             Send SetMemberValue of hoJson "Nombre" jsonTypeString Centros.Nombre
39776>>>             Send SetMemberValue of hoJson "PsNombre" jsonTypeString Centros.PsNombre
39777>>>             Send SetMemberValue of hoJson "Direccion" jsonTypeString Centros.Direccion
39778>>>             Send SetMemberValue of hoJson "Pais" jsonTypeString Centros.Pais
39779>>>             Send SetMemberValue of hoJson "ComunidadAutonoma" jsonTypeString Centros.ComunidadAutonoma
39780>>>             Send SetMemberValue of hoJson "Localidad" jsonTypeString Centros.Localidad
39781>>>             Send SetMemberValue of hoJson "CodigoPostal" jsonTypeInteger Centros.CodigoPostal
39782>>>             Send SetMemberValue of hoJson "Empresa" jsonTypeString Centros.Empresa
39783>>>//             Send SetMemberValue of hoJson "FechaCreacionRegistro" jsonTypeString Centros.FechaCreacionRegistro
39783>>>//             Send SetMemberValue of hoJson "FechaUltimaModificacion" jsonTypeString Centros.FechaUltimaModificacion
39783>>>            
39783>>>            Send OutputJson hoJson
39784>>>            Send Destroy of hoJson
39785>>>        End
39785>>>>
39785>>>        Else Begin
39786>>>            Send SetResponseStatus 404 "Resource not found"
39787>>>        End
39787>>>>
39787>>>    End_Procedure
