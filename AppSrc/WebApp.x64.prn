38879>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38882>>>        Case Begin
38882>>>            Case (NavigateData.eNavigateType = nfFromMain)
38884>>>                // If from main, this is a propbably a main file Select to Zoom.
38884>>>                
38884>>>                 Boolean bHasRecord
38884>>>                    Get HasRecord of oAlumnos_DD to bHasRecord
38885>>>                    
38885>>>                    If bHasRecord Begin
38887>>>                        Send SetBreadCrumbCaption (Trim(Alumnos.Nombre +" "+ Alumnos.Apellidos))
38888>>>                        Send SetHeaderCaption (Trim(Alumnos.Nombre +" "+ Alumnos.Apellidos))
38889>>>                    End
38889>>>>
38889>>>                Case Break
38890>>>
38890>>>            Case (NavigateData.eNavigateType = nfFromParent)
38893>>>                // If from parent, this is a constrained drill down.
38893>>>                Case Break
38894>>>
38894>>>            Case (NavigateData.eNavigateType = nfFromChild)
38897>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38897>>>                Case Break
38898>>>
38898>>>            Case Else // must be nfUndefined
38898>>>
38898>>>        Case End
38898>>>
38898>>>        Send SetActionButtons
38899>>>
38899>>>    End_Procedure
