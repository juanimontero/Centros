38201>>>>>>>>>Class cJsonHttpTransfer is a cHttpTransfer
38202>>>>>>>>>    
38202>>>>>>>>>    Procedure Construct_Object
38204>>>>>>>>>        Forward Send Construct_object
38206>>>>>>>>>        
38206>>>>>>>>>        Property String  psContentTypeSent "application/json; charset=utf-8"     // default content type for posted data
38207>>>>>>>>>        
38207>>>>>>>>>        Property Boolean pbClearHeaders      True         // should headers always be cleared after a post
38208>>>>>>>>>        
38208>>>>>>>>>        Property UChar[] pucDataReceived                 // maintained by object
38209>>>>>>>>>        
38209>>>>>>>>>        Property String  psContentTypeReceived ''         // content type received
38210>>>>>>>>>        
38210>>>>>>>>>        Property String  psJsonParseError ''              // Set if response JSON can't be parsed
38211>>>>>>>>>        
38211>>>>>>>>>        Property String  psContentTypeExpected 'application/json' // content type received - expected value should be contained in here.
38212>>>>>>>>>        
38212>>>>>>>>>        Property Integer peJsonTransferStatus jtsOk
38213>>>>>>>>>        
38213>>>>>>>>>        // if true, the http post does not happend and whatever was posted is just returned as a copy.
38213>>>>>>>>>        // Good for internal Testing
38213>>>>>>>>>        Property Boolean pbPostLoopTest False
38214>>>>>>>>>        
38214>>>>>>>>>        Set piBufferSize to -1  //  No chunking needed
38215>>>>>>>>>        Set psAcceptTypes to "application/json"
38216>>>>>>>>>    End_Procedure
38217>>>>>>>>>    
38217>>>>>>>>>    // private helper function. Convert data passed by pointer to an JSON document.
38217>>>>>>>>>    // return 0, if error
38217>>>>>>>>>    //
38217>>>>>>>>>    Function UCharDatatoJson UChar[] ucJson Returns Handle
38219>>>>>>>>>        Integer iVoid bOk
38219>>>>>>>>>        Handle hoJson
38219>>>>>>>>>        String sError
38219>>>>>>>>>        Get Create of Desktop (RefClass(cJsonObject)) to hoJson
38220>>>>>>>>>        Get ParseUTF8 of hoJson ucJson to bOk
38221>>>>>>>>>        If not bOk Begin
38223>>>>>>>>>            // store the JSON parse error info
38223>>>>>>>>>            Get psParseError of hoJson to sError
38224>>>>>>>>>            Set psJsonParseError to sError
38225>>>>>>>>>            Send Destroy of hoJson
38226>>>>>>>>>            Move 0 to hoJson
38227>>>>>>>>>        End
38227>>>>>>>>>>
38227>>>>>>>>>        Function_Return hoJson
38228>>>>>>>>>    End_Function
38229>>>>>>>>>    
38229>>>>>>>>>    // Clear pucDataReceived
38229>>>>>>>>>    Procedure ClearDataReceived
38231>>>>>>>>>        UChar[] ucEmpty
38232>>>>>>>>>        
38232>>>>>>>>>        Set pucDataReceived to ucEmpty
38233>>>>>>>>>        Set psJsonParseError to ''
38234>>>>>>>>>    End_Procedure
38235>>>>>>>>>    
38235>>>>>>>>>    // augment to release any memor
38235>>>>>>>>>    Procedure Destroy_Object
38237>>>>>>>>>        Send ClearDataReceived
38238>>>>>>>>>        Forward Send Destroy_object
38240>>>>>>>>>    End_Procedure
38241>>>>>>>>>    
38241>>>>>>>>>    // called during http transfer. Take passed data and append to pucDataReceived.
38241>>>>>>>>>    // If new transfer save contenttype.
38241>>>>>>>>>    Procedure OnDataReceivedUC String sContentType UChar[] ucData
38243>>>>>>>>>        UChar[] ucBuffer
38244>>>>>>>>>        Integer iDataLen
38244>>>>>>>>>        
38244>>>>>>>>>        Move (SizeOfArray(ucData)) to iDataLen
38245>>>>>>>>>        
38245>>>>>>>>>        If (iDataLen > 0) Begin
38247>>>>>>>>>            Get pucDataReceived to ucBuffer
38248>>>>>>>>>            If (SizeOfArray(ucBuffer) > 0) Begin
38250>>>>>>>>>                Set pucDataReceived to (AppendArray(ucBuffer, ucData))
38251>>>>>>>>>            End
38251>>>>>>>>>>
38251>>>>>>>>>            Else Begin
38252>>>>>>>>>                Set psContentTypeReceived to sContentType
38253>>>>>>>>>                
38253>>>>>>>>>                If (iDataLen > 3 and ucData[0]=C_BOM1 and ucData[1]=C_BOM2 and ucData[2]=C_BOM3) Begin
38255>>>>>>>>>                    Set pucDataReceived to (CopyArray(ucData, 3, iDataLen - 1))
38256>>>>>>>>>                End
38256>>>>>>>>>>
38256>>>>>>>>>                Else Begin
38257>>>>>>>>>                    Set pucDataReceived to ucData
38258>>>>>>>>>                End
38258>>>>>>>>>>
38258>>>>>>>>>            End
38258>>>>>>>>>>
38258>>>>>>>>>        End
38258>>>>>>>>>>
38258>>>>>>>>>    End_Procedure
38259>>>>>>>>>    
38259>>>>>>>>>    Function LoopDataBack UChar[] ucData Returns Boolean
38261>>>>>>>>>        Pointer pInData
38261>>>>>>>>>        Boolean bOk
38261>>>>>>>>>        
38261>>>>>>>>>        Set pucDataReceived to ucData
38262>>>>>>>>>        Set psContentTypeReceived to (psContentTypeExpected(Self))
38263>>>>>>>>>        
38263>>>>>>>>>        Function_Return True
38264>>>>>>>>>    End_Function
38265>>>>>>>>>    
38265>>>>>>>>>    
38265>>>>>>>>>    Function HttpVerbJsonAddrExec String sHost String sFilePath Pointer pJson Integer iLen String sVerb  Returns Boolean
38267>>>>>>>>>        Boolean bOk
38267>>>>>>>>>        Integer iError
38267>>>>>>>>>        String sContentType
38267>>>>>>>>>        
38267>>>>>>>>>        Send ClearDataReceived  // this should be zero, just in case it is not
38268>>>>>>>>>        Set psRemoteHost to sHost
38269>>>>>>>>>        
38269>>>>>>>>>        Get psContentTypeSent to sContentType
38270>>>>>>>>>        If (iLen > 0 and sContentType <> "") Begin
38272>>>>>>>>>            Get AddHeader "Content-Type" sContentType to bok
38273>>>>>>>>>        End
38273>>>>>>>>>>
38273>>>>>>>>>        Get HttpVerbAddrRequest sFilePath pJson iLen False sVerb to bOK
38274>>>>>>>>>        
38274>>>>>>>>>        // You need to clear headers between posts. If you need to set custom headers you should
38274>>>>>>>>>        // set pbClearHeaders to false and then manually send ClearHeaders and AddHeaders in your code
38274>>>>>>>>>        If (pbClearHeaders(Self)) ;            Send ClearHeaders
38277>>>>>>>>>        
38277>>>>>>>>>        
38277>>>>>>>>>        Function_Return bOk
38278>>>>>>>>>    End_Function
38279>>>>>>>>>    
38279>>>>>>>>>    // We assume but do not verify that the data in ucJson is actually UTF8 JSON
38279>>>>>>>>>    Function HttpVerbJsonUChar String sHost String sFilePath UChar[] ucJson String sVerb Returns UChar[]
38281>>>>>>>>>        Integer iLen
38281>>>>>>>>>        Boolean bOk
38281>>>>>>>>>        UChar[] ucJsonReceived
38282>>>>>>>>>        String sContentTypeReceived sContentTypeExpected
38282>>>>>>>>>        
38282>>>>>>>>>        Move (SizeOfArray(ucJson)) to iLen
38283>>>>>>>>>        
38283>>>>>>>>>        If (pbPostLoopTest(Self)) Begin
38285>>>>>>>>>            Get LoopDataBack ucJson to bOk
38286>>>>>>>>>        End
38286>>>>>>>>>>
38286>>>>>>>>>        Else Begin
38287>>>>>>>>>            Get HttpVerbJsonAddrExec sHost sFilePath (AddressOf(ucJson)) iLen sVerb to bOk
38288>>>>>>>>>        End
38288>>>>>>>>>>
38288>>>>>>>>>                
38288>>>>>>>>>        If bOk Begin
38290>>>>>>>>>            Set peJsonTransferStatus to jtsOk
38291>>>>>>>>>            Get pucDataReceived to ucJsonReceived
38292>>>>>>>>>            
38292>>>>>>>>>            If (SizeOfArray(ucJsonReceived) > 0) Begin
38294>>>>>>>>>                // we have data, check that the content type is ok. This is as far
38294>>>>>>>>>                // as we can go here.
38294>>>>>>>>>                Get psContentTypeReceived to sContentTypeReceived
38295>>>>>>>>>                Get psContentTypeExpected to sContentTypeExpected
38296>>>>>>>>>                // If contentType expected is empty, we allow anything
38296>>>>>>>>>                If (sContentTypeExpected<>"" and pos(lowercase(sContentTypeExpected),lowercase(sContentTypeReceived))=0) Begin
38298>>>>>>>>>                    Set peJsonTransferStatus to jtsInvalidContentType
38299>>>>>>>>>                End
38299>>>>>>>>>>
38299>>>>>>>>>            End
38299>>>>>>>>>>
38299>>>>>>>>>        End
38299>>>>>>>>>>
38299>>>>>>>>>        Else Begin
38300>>>>>>>>>            Set peJsonTransferStatus to jtsHttpRequestFailed
38301>>>>>>>>>        End
38301>>>>>>>>>>
38301>>>>>>>>>                
38301>>>>>>>>>        Function_Return ucJsonReceived
38302>>>>>>>>>    End_Function
38303>>>>>>>>>    
38303>>>>>>>>>    // Generic HTTP Request - it is passed the Verb. Used by all other http requests
38303>>>>>>>>>    Function HttpVerbJson  String sHost String sFilePath Handle  hoJsonRequest String sVerb Boolean ByRef bOk Returns Handle
38305>>>>>>>>>        UChar[] ucJsonRequest ucJsonResponse
38307>>>>>>>>>        Handle hoJsonResponse
38307>>>>>>>>>        Integer eStat
38307>>>>>>>>>        
38307>>>>>>>>>        If (hoJsonRequest<>0) Begin
38309>>>>>>>>>            Get StringifyUTF8 of hoJsonRequest to ucJsonRequest
38310>>>>>>>>>        End
38310>>>>>>>>>>
38310>>>>>>>>>        
38310>>>>>>>>>        Get HttpVerbJsonUChar sHost sFilePath ucJsonRequest sVerb to ucJsonResponse
38311>>>>>>>>>        
38311>>>>>>>>>        If (SizeOfArray(ucJsonResponse)) Begin
38313>>>>>>>>>            Get UCharDatatoJson ucJsonResponse to hoJsonResponse
38314>>>>>>>>>            If (hoJsonResponse=0) Begin
38316>>>>>>>>>                // this indicates that data was returned but it could not be loaded as Json
38316>>>>>>>>>                Set peJsonTransferStatus to jtsNotJson
38317>>>>>>>>>                // note bad data is still is ppDataReceived (might be useful for debugging)
38317>>>>>>>>>            End
38317>>>>>>>>>>
38317>>>>>>>>>        End
38317>>>>>>>>>>
38317>>>>>>>>>        
38317>>>>>>>>>        // return Ok status by reference
38317>>>>>>>>>        Get peJsonTransferStatus to eStat
38318>>>>>>>>>        Move (eStat=jtsOk) to bOk
38319>>>>>>>>>        
38319>>>>>>>>>        Function_Return hoJsonResponse
38320>>>>>>>>>    End_Function
38321>>>>>>>>>    
38321>>>>>>>>>    Function HttpPostJson String sHost String sFilePath Handle hoJsonRequest Boolean ByRef bOk Returns Handle
38323>>>>>>>>>        Handle hoJson
38323>>>>>>>>>        Get HttpVerbJson sHost sFilePath hoJsonRequest "POST" (&bOk) to hoJson
38324>>>>>>>>>        Function_Return hoJson
38325>>>>>>>>>    End_Function
38326>>>>>>>>>    
38326>>>>>>>>>    Function HttpGetJson String sHost String sFilePath Boolean ByRef bOk Returns Handle
38328>>>>>>>>>        Pointer pJson
38328>>>>>>>>>        Integer iVoid iLen
38328>>>>>>>>>        Handle hoJson
38328>>>>>>>>>        Get HttpVerbJson sHost sFilePath 0 "GET" (&bOk) to hoJson
38329>>>>>>>>>        Function_Return hoJson
38330>>>>>>>>>    End_Function
38331>>>>>>>>>    
38331>>>>>>>>>    Function HttpPutJson String sHost String sFilePath Handle hoJsonRequest Boolean ByRef bOk Returns Handle
38333>>>>>>>>>        Handle hoJson
38333>>>>>>>>>        Get HttpVerbJson sHost sFilePath hoJsonRequest "PUT" (&bOk) to hoJson
38334>>>>>>>>>        Function_Return hoJson
38335>>>>>>>>>    End_Function
38336>>>>>>>>>    
38336>>>>>>>>>    Function HttpDeleteJson String sHost String sFilePath Handle hoJsonRequest Boolean ByRef bOk Returns Handle
38338>>>>>>>>>        Handle hoJson
38338>>>>>>>>>        Get HttpVerbJson sHost sFilePath hoJsonRequest "DELETE" (&bOk) to hoJson
38339>>>>>>>>>        Function_Return hoJson
38340>>>>>>>>>    End_Function
38341>>>>>>>>>    
38341>>>>>>>>>    Function HttpPatchJson  String sHost String sFilePath Handle hoJsonRequest Boolean ByRef bOk Returns Handle
38343>>>>>>>>>        Handle hoJson
38343>>>>>>>>>        Get HttpVerbJson sHost sFilePath hoJsonRequest "PATCH" (&bOk) to hoJson
38344>>>>>>>>>        Function_Return hoJson
38345>>>>>>>>>    End_Function
38346>>>>>>>>>    
38346>>>>>>>>>    // After an Json xfer request this message can be sent to display an error message if one occurred.
38346>>>>>>>>>    // Normally you would first check peJsonTransferStatus to see if it is not jtsOk. If not, send
38346>>>>>>>>>    // LastError to see the error
38346>>>>>>>>>    
38346>>>>>>>>>    // return last JSON transfer error text
38346>>>>>>>>>    Function TransferErrorDescription Returns String
38348>>>>>>>>>        String  sError sJsonError
38348>>>>>>>>>        Integer eJsonTransferStatus
38348>>>>>>>>>        Get peJsonTransferStatus to eJsonTransferStatus
38349>>>>>>>>>        Get psJsonParseError to sJsonError
38350>>>>>>>>>        Case Begin
38350>>>>>>>>>            Case (eJsonTransferStatus=jtsOk) ;                Move '' to sError
38353>>>>>>>>>            Case (eJsonTransferStatus=jtsHttpRequestFailed) ;                Move C_$HttpRequestFailed to sError
38357>>>>>>>>>            Case (eJsonTransferStatus=jtsInvalidContentType) ;                Move (SFormat(C_$InvalidContentTypeReceived,psContentTypeReceived(Self))) to sError
38361>>>>>>>>>            Case (eJsonTransferStatus=jtsNotJson) ;                Move (C_$ReceivedDataNotInJsonFormat * sJsonError) to sError
38365>>>>>>>>>            Case Else ;                Move C_$ReceivedDataIsBad to sError
38367>>>>>>>>>        Case End
38367>>>>>>>>>        Function_Return sError
38368>>>>>>>>>    End_Function
38369>>>>>>>>>    
38369>>>>>>>>>    // can be send to raise an error.
38369>>>>>>>>>    Procedure LastError
38371>>>>>>>>>        Integer eJsonTransferStatus
38371>>>>>>>>>        String sError
38371>>>>>>>>>        
38371>>>>>>>>>        Get peJsonTransferStatus to eJsonTransferStatus
38372>>>>>>>>>        If (eJsonTransferStatus<>jtsOk) Begin
38374>>>>>>>>>            Get TransferErrorDescription to sError
38375>>>>>>>>>            Error DFERR_JSON_HTTP sError
38376>>>>>>>>>>
38376>>>>>>>>>        End
38376>>>>>>>>>>
38376>>>>>>>>>    End_Procedure
38377>>>>>>>>>    
38377>>>>>>>>>    
38377>>>>>>>>>End_Class
38378>>>>>>>
38378>>>>>>>
38378>>>>>>>Function zTelefonoValidation Boolean bUseApi String sPrefijo String sTelefono  String ByRef sMsg Returns Boolean
38381>>>>>>>     Boolean bRet    
38381>>>>>>>//-------------------LLamada a Validacion basica-------------------       
38381>>>>>>>     Get zNumeroCorrecto sTelefono (&sMsg) to bRet
38382>>>>>>>     If (not(bRet)) Function_Return False 
38385>>>>>>>//-------------------LLamada a Api-------------------     
38385>>>>>>>     If (bUseApi) Get zValidarConApi sTelefono sPrefijo (&sMsg) to bRet
38388>>>>>>>     If (not(bRet)) Function_Return False
38391>>>>>>>//-------------------Si todo ha salido bien retorna true-------------------      
38391>>>>>>>    Function_Return True
38392>>>>>>>End_Function
38393>>>>>>>
38393>>>>>>>Function zNumeroCorrecto String sTelefono String ByRef sMsg Returns Boolean
38396>>>>>>>    String[] aRet
38397>>>>>>>//-------------------Expresion regular para cualquier formato internacional de telefono-------------------  
38397>>>>>>>    Object oTelefonopattern is a cRegEx
38399>>>>>>>        Set psExpression to "^(?:[-\s])?\d(?:[\d\s-]*\d)?(?:[-\s])?$"
38400>>>>>>>    End_Object
38401>>>>>>>    Get MatchAll of oTelefonopattern (sTelefono) to aRet
38402>>>>>>>        If (SizeOfArray(aRet) = 1) Begin
38404>>>>>>>            Function_Return True
38405>>>>>>>        End
38405>>>>>>>>
38405>>>>>>>    Move "Porfavor Introduzca un formato de Telefono valido" to sMsg
38406>>>>>>>    Function_Return False    
38407>>>>>>>End_Function 
38408>>>>>>>
38408>>>>>>>Function zValidarConApi String sTelefono String sPrefijo String ByRef sMsg Returns Boolean    
38411>>>>>>>    Handle hoJsonReceived hoHttp
38411>>>>>>>    Boolean bOk bIsNull bRet
38411>>>>>>>    String  sNum sUrl
38411>>>>>>>     // ----
38411>>>>>>>    Move (sPrefijo + sTelefono) to sNum   
38412>>>>>>>    Get Create (RefClass(cJsonHttpTransfer)) to hoHttp
38413>>>>>>>    Move False to bRet
38414>>>>>>>//-------------------LLamada a Api-------------------      
38414>>>>>>>    Get HttpGetJson of hohttp ("phonevalidation.abstractapi.com") ("/v1/?api_key=713383f7f21e45b1ac4054a472e00971&phone=" + sNum) (&bOk) to hoJsonReceived
38415>>>>>>>//-------------------Lanza un mensaje de error si la llamada a fallado-------------------      
38415>>>>>>>    If (not(bOk)) Move "La llamada a la Api ha fallado" to sMsg
38418>>>>>>>//-------------------LLamada a Api-------------------  
38418>>>>>>>    If (bOk = True and ResponseStatusCode(hohttp) = 200 and hoJsonReceived <> 0) Begin        
38420>>>>>>>        If (HasMember(hoJsonReceived,"valid"))  Begin
38422>>>>>>>            Get IsMemberOfJsonType of hoJsonReceived "valid" jsonTypeNull  to bIsNull
38423>>>>>>>            If bIsNull  Move False to bRet
38426>>>>>>>            Else Move (MemberValue(hoJsonReceived,"valid")) to bRet
38428>>>>>>>        End
38428>>>>>>>>
38428>>>>>>>//-------------------Lanza un mensaje de error si No existe ese número-------------------          
38428>>>>>>>        If (not(bRet)) Move "No es valido el dni" to sMsg
38431>>>>>>>    End
38431>>>>>>>>
38431>>>>>>>    Send Destroy of hohttp
38432>>>>>>>    Function_Return bRet
38433>>>>>>>End_Function
38434>>>>>>>    
