39532>>>Object oSimpleHTTPHandler is a cWebHttpHandler
39534>>>    Set psPath to "Status"
39535>>>    Set psVerbs to "GET"
39536>>>
39536>>>    Procedure OnHttpGet String sPath String sAcceptType
39539>>>        String sCode 
39539>>>        Integer iStatusActual
39539>>>        Get UrlParameter "Code" to sCode
39540>>>  
39540>>>        Case Begin
39540>>>            Case (sCode = "200")
39542>>>                Send SetResponseStatus 200 "OK" 0
39543>>>            Case Break
39544>>>            
39544>>>            Case (sCode = "202")
39547>>>                Send SetResponseStatus 202 "Accepted" 0
39548>>>            Case Break
39549>>>            
39549>>>            Case (sCode = "302")
39552>>>                Send SetResponseStatus 302 "Found" 0
39553>>>            Case Break
39554>>>            
39554>>>            Case (sCode = "307")
39557>>>                Send SetResponseStatus 307 "Temporary Redirect" 0
39558>>>            Case Break
39559>>>            
39559>>>            Case (sCode = "404")
39562>>>                Send SetResponseStatus 404 "Not found" 0
39563>>>            Case Break
39564>>>            
39564>>>            Case (sCode = "406")
39567>>>                Send SetResponseStatus 406 "Not Acceptable" 0
39568>>>            Case Break
39569>>>            
39569>>>            Case (sCode = "500")
39572>>>                Send SetResponseStatus 500 "Internal Servel Error" 0
39573>>>            Case Break
39574>>>            
39574>>>            Case (sCode = "508")
39577>>>                Send SetResponseStatus 508 "Loop detected" 0
39578>>>            Case Break
39579>>>        
39579>>>        
39579>>>        Case End   
39579>>>        
39579>>>    //----
39579>>>        Send AddHttpResponseHeader "Content-Type" "text/html"
39580>>>        Send OutputString '<html>'
39581>>>        Send OutputString '<head><title>Status</title></head>'
39582>>>        Send OutputString (SFormat('<body><h1>Status =  %1!</h1></body>', sCode))
39583>>>        Send OutputString '</html>'
39584>>>        
39584>>>        
39584>>>                
39584>>>    End_Procedure
39585>>>End_Object
