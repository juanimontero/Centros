38377>>>>>>>
38377>>>>>>>Function zTelefonoValidation Boolean bUseApi String sPrefijo String sTelefono  String ByRef sMsg Returns Boolean
38380>>>>>>>     Boolean bRet    
38380>>>>>>>//-------------------LLamada a Validacion basica-------------------       
38380>>>>>>>     Get zNumeroCorrecto sTelefono (&sMsg) to bRet
38381>>>>>>>     If (not(bRet)) Function_Return False 
38384>>>>>>>//-------------------LLamada a Api-------------------     
38384>>>>>>>     If (bUseApi) Get zValidarConApi sTelefono sPrefijo (&sMsg) to bRet
38387>>>>>>>     If (not(bRet)) Function_Return False
38390>>>>>>>//-------------------Si todo ha salido bien retorna true-------------------      
38390>>>>>>>    Function_Return True
38391>>>>>>>End_Function
38392>>>>>>>
38392>>>>>>>Function zNumeroCorrecto String sTelefono String ByRef sMsg Returns Boolean
38395>>>>>>>    String[] aRet
38396>>>>>>>//-------------------Expresion regular para cualquier formato internacional de telefono-------------------  
38396>>>>>>>    Object oTelefonopattern is a cRegEx
38398>>>>>>>        Set psExpression to "^(?:[-\s])?\d(?:[\d\s-]*\d)?(?:[-\s])?$"
38399>>>>>>>    End_Object
38400>>>>>>>    Get MatchAll of oTelefonopattern (sTelefono) to aRet
38401>>>>>>>        If (SizeOfArray(aRet) = 1) Begin
38403>>>>>>>            Function_Return True
38404>>>>>>>        End
38404>>>>>>>>
38404>>>>>>>    Move "Porfavor Introduzca un formato de Telefono valido" to sMsg
38405>>>>>>>    Function_Return False    
38406>>>>>>>End_Function 
38407>>>>>>>
38407>>>>>>>Function zValidarConApi String sTelefono String sPrefijo String ByRef sMsg Returns Boolean    
38410>>>>>>>    Handle hoJsonReceived hoHttp
38410>>>>>>>    Boolean bOk bIsNull bRet
38410>>>>>>>    String  sNum sUrl
38410>>>>>>>     // ----
38410>>>>>>>    Move (sPrefijo + sTelefono) to sNum   
38411>>>>>>>    Get Create (RefClass(cJsonHttpTransfer)) to hoHttp
38412>>>>>>>    Move False to bRet
38413>>>>>>>//-------------------LLamada a Api-------------------      
38413>>>>>>>    Get HttpGetJson of hohttp ("phonevalidation.abstractapi.com") ("/v1/?api_key=713383f7f21e45b1ac4054a472e00971&phone=" + sNum) (&bOk) to hoJsonReceived
38414>>>>>>>//-------------------Lanza un mensaje de error si la llamada a fallado-------------------      
38414>>>>>>>    If (not(bOk)) Move "La llamada a la Api ha fallado" to sMsg
38417>>>>>>>//-------------------LLamada a Api-------------------  
38417>>>>>>>    If (bOk = True and ResponseStatusCode(hohttp) = 200 and hoJsonReceived <> 0) Begin        
38419>>>>>>>        If (HasMember(hoJsonReceived,"valid"))  Begin
38421>>>>>>>            Get IsMemberOfJsonType of hoJsonReceived "valid" jsonTypeNull  to bIsNull
38422>>>>>>>            If bIsNull  Move False to bRet
38425>>>>>>>            Else Move (MemberValue(hoJsonReceived,"valid")) to bRet
38427>>>>>>>        End
38427>>>>>>>>
38427>>>>>>>//-------------------Lanza un mensaje de error si No existe ese número-------------------          
38427>>>>>>>        If (not(bRet)) Move "No es valido el dni" to sMsg
38430>>>>>>>    End
38430>>>>>>>>
38430>>>>>>>    Send Destroy of hohttp
38431>>>>>>>    Function_Return bRet
38432>>>>>>>End_Function
38433>>>>>>>    
