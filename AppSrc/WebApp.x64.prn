39612>>>    Procedure OnHttpGet String sPath String sAcceptType
39615>>>        String[] aPath
39616>>>        
39616>>>        //  Split the path into parts
39616>>>        Get StrSplitToArray sPath "/" to aPath
39617>>>        If (SizeOfArray(aPath) = 0) Begin
39619>>>               Send ListaCentros
39620>>>            Procedure_Return
39621>>>        End
39621>>>>
39621>>>        
39621>>>        //  Redirect to a specific operation based on the path
39621>>>        If (Lowercase(aPath[1]) <> "" and SizeOfArray(aPath) > 0 and Lowercase(aPath[1]) <> "centros") Begin
39623>>>            If (SizeOfArray(aPath) > 1) Begin
39625>>>                Send listarporid aPath[1]
39626>>>            End
39626>>>>
39626>>>        End
39626>>>>
39626>>>        
39626>>>            Else Begin
39627>>>            Send SetResponseStatus 404 "Unknown resource" 
39628>>>            End
39628>>>>
