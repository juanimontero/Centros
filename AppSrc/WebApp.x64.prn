38836>>>        Boolean bHasRecord
38836>>>        Handle hoDD
38836>>>
38836>>>        Get Server to hoDD
38837>>>        Get GetNavigateData to NavigateData
38838>>>        Get HasRecord of hoDD to bHasRecord
38839>>>
38839>>>        // let's hide all buttons and then Show the ones we want
38839>>>        WebSet pbRender of oEditBtn to False
38840>>>        WebSet pbRender of oSaveBtn to False
38841>>>        WebSet pbRender of oCancelChangesBtn to False
38842>>>        WebSet pbRender of oDeleteBtn to False
38843>>>
38843>>>        If (NavigateData.bReadOnly) Begin
38845>>>            WebSet pbRender of oEditBtn to True
38846>>>        End
38846>>>>
38846>>>        Else Begin
38847>>>            WebSet pbRender of oSaveBtn to True
38848>>>            WebSet pbRender of oCancelChangesBtn to True
38849>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38850>>>        End
38850>>>>
38850>>>    End_Procedure
