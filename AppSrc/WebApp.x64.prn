36743>>>>>>>    Function CNG_PBKDF2_HMAC    WString wsAlgo ;                                UChar[] ucaData ;                                UChar[] ucaSalt ;                                UInteger uiTimeCost ;                                UChar[] ByRef ucaHashOut ;                                Boolean bOptThrow ;                                Returns Boolean
36745>>>>>>>        Integer iErr iHashLen
36745>>>>>>>        
36745>>>>>>>        // Handle Optionals
36745>>>>>>>        // First the optional throwing of errors.
36745>>>>>>>        Boolean bThrow
36745>>>>>>>        Move True to bThrow
36746>>>>>>>        If (num_arguments > 4) Move bOptThrow to bThrow
36749>>>>>>>        
36749>>>>>>>        // Open the algorithm.
36749>>>>>>>        Handle hoProv
36749>>>>>>>        Move (CNG_BCryptOpenAlgorithmProvider(AddressOf(hoProv), AddressOf(wsAlgo), 0, |CI$00000008 /*BCRYPT_ALG_HANDLE_HMAC_FLAG*/)) to iErr
36750>>>>>>>        If (iErr) Begin
36752>>>>>>>            If (bThrow) Error 8710 "Failed to open up the algo provider."
36755>>>>>>>            Function_Return False
36756>>>>>>>        End
36756>>>>>>>>
36756>>>>>>>        
36756>>>>>>>        Get CNG_PBKDF2_HMAC_BufferSizeEx hoProv to iHashLen
36757>>>>>>>        If (not(iHashLen)) Begin
36759>>>>>>>            If (bThrow) Error 8710 "Failed to get expected length of hash."
36762>>>>>>>            Function_Return False
36763>>>>>>>        End
36763>>>>>>>>
36763>>>>>>>        
36763>>>>>>>        // Resize buffers to the expected output.
36763>>>>>>>        Move (ResizeArray(ucaHashOut, iHashLen)) to ucaHashOut
36764>>>>>>>        
36764>>>>>>>        Move (CNG_BCryptDeriveKeyPBKDF2(hoProv, AddressOf(ucaData), SizeOfArray(ucaData), AddressOf(ucaSalt), SizeOfArray(ucaSalt), uiTimeCost, AddressOf(ucaHashOut), SizeOfArray(ucaHashOut), 0)) to iErr
36765>>>>>>>        If (iErr) Begin
36767>>>>>>>            Move (CNG_BCryptCloseAlgorithmProvider(hoProv, 0)) to iErr
36768>>>>>>>            If (bThrow) Error 8710 "Failed to create hash."
36771>>>>>>>            Function_Return False
36772>>>>>>>        End
36772>>>>>>>>
36772>>>>>>>        
36772>>>>>>>        Move (CNG_BCryptCloseAlgorithmProvider(hoProv, 0)) to iErr
36773>>>>>>>        If (iErr) Begin
36775>>>>>>>            If (bThrow) Error 8710 "Failed to close algo provider."
36778>>>>>>>            Function_Return False
36779>>>>>>>        End
36779>>>>>>>>
36779>>>>>>>        
36779>>>>>>>        Function_Return True
36780>>>>>>>    End_Function
36781>>>>>>>End_Class
