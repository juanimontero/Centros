39637>>>    Procedure OnHttpPost String sPath String sContentType String sAcceptType Integer iSize
39640>>>      String[] aPath
39641>>>      String[][] aUserValid
39642>>>      String sUser sPassword
39642>>>      Integer i iRegisteredUsers   
39642>>>      Boolean Flag
39642>>>      
39642>>>      Move False to Flag
39643>>>      
39643>>>        //----
39643>>>         Get HttpRequestHeader "user" to sUser
39644>>>         Get HttpRequestHeader "password" to sPassword
39645>>>        //---- 
39645>>>         Get SQLExecDirect of ghoSQLExecutor @SQL" SELECT LoginName, Password                            FROM Centros.dbo.WebAppUser;" to aUserValid
39646>>>                            
39646>>>         Move (SizeOfArray(aUserValid)) to iRegisteredUsers                   
39647>>>        
39647>>>         For i from 0 to (iRegisteredUsers - 1)
39653>>>>
39653>>>            If (aUserValid[i][0] = sUser and aUserValid[i][1] = sPassword) Begin
39655>>>                Move True to Flag
39656>>>            End
39656>>>>
39656>>>         Loop
39657>>>>
39657>>>         
39657>>>         If (Flag = False) Begin
39659>>>            Send SetResponseStatus 401 "Credenciales incorrectas o sin Autirizacion"
39660>>>            Procedure_Return
39661>>>         End
39661>>>>
39661>>>        
39661>>>        //  Split the path into parts
39661>>>        Get StrSplitToArray sPath "/" to aPath
39662>>>        If (SizeOfArray(aPath) < 2) Begin
39664>>>            Send SetResponseStatus 404 "Invalid resource" 
39665>>>            Procedure_Return
39666>>>        End
39666>>>>
39666>>>        
39666>>>        //  Redirect to a specific operation based on the path
39666>>>        If (Lowercase(aPath[1]) = "centros") Begin
39668>>>            If (SizeOfArray(aPath) > 2 and aPath[2] <> "") Begin
39670>>>                Send SetResponseStatus 401 "Only use POST for creating new resources"
39671>>>            End
39671>>>>
39671>>>            Else Begin
39672>>>                Send CrearCentro True ""
39673>>>            End
39673>>>>
39673>>>        End
39673>>>>
39673>>>        Else Begin
39674>>>            Send SetResponseStatus 404 "Unknown resource"
39675>>>        End
39675>>>>
39675>>>    
39675>>>    End_Procedure
