37381>>>    Procedure DoLogin
37384>>>        String sLoginName sPassword sPrevStateHash
37384>>>        Boolean bResult
37384>>>        
37384>>>        WebGet psValue of oLoginName to sLoginName
37385>>>        WebGet psValue of oPassword to sPassword
37386>>>        
37386>>>        Get UserLogin of ghoWebSessionManager sLoginName sPassword to bResult
37387>>>        
37387>>>        If (bResult) Begin
37389>>>            Send Hide of oLogin
37390>>>            Send ShowHeader of ghoWebApp
37391>>>            WebSet psCSSClass of ghoWebApp to ""
37392>>>            
37392>>>            WebGet psPrevStateHash to sPrevStateHash
37393>>>            Send NavigateToStateHash of ghoWebApp sPrevStateHash True
37394>>>            
37394>>>            // clear the login values. we don't want to return the login id & password as synchronized properties....
37394>>>            WebSet psValue of oLoginName to ""
37395>>>            WebSet psValue of oPassword  to ""
37396>>>            WebSet pbVisible of oWarning to False
37397>>>        End
37397>>>>
37397>>>        Else Begin
37398>>>            WebSet pbVisible of oWarning to True
37399>>>        End
37399>>>>
37399>>>    End_Procedure
