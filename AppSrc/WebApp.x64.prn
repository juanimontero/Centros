39629>>>    Procedure OnHttpPost String sPath String sContentType String sAcceptType Integer iSize
39632>>>      String[] aPath
39633>>>      String[][] aUserValid
39634>>>      String sUser sPassword
39634>>>      Integer i iRegisteredUsers   
39634>>>      Boolean Flag
39634>>>      
39634>>>      Move False to Flag
39635>>>      
39635>>>        //----
39635>>>         Get HttpRequestHeader "user" to sUser
39636>>>         Get HttpRequestHeader "password" to sPassword
39637>>>        //---- 
39637>>>         Get SQLExecDirect of ghoSQLExecutor @SQL" SELECT LoginName, Password                            FROM Centros.dbo.WebAppUser;" to aUserValid
39638>>>                            
39638>>>         Move (SizeOfArray(aUserValid)) to iRegisteredUsers                   
39639>>>        
39639>>>         For i from 0 to (iRegisteredUsers - 1)
39645>>>>
39645>>>            If (aUserValid[i][0] = sUser and aUserValid[i][1] = sPassword) Begin
39647>>>                Move True to Flag
39648>>>            End
39648>>>>
39648>>>         Loop
39649>>>>
39649>>>         
39649>>>         If (Flag = False) Begin
39651>>>            Send SetResponseStatus 401 "Credenciales incorrectas o sin Autirizacion"
39652>>>            Procedure_Return
39653>>>         End
39653>>>>
39653>>>        
39653>>>        //  Split the path into parts
39653>>>        Get StrSplitToArray sPath "/" to aPath
39654>>>        If (SizeOfArray(aPath) < 2) Begin
39656>>>            Send SetResponseStatus 404 "Invalid resource" 
39657>>>            Procedure_Return
39658>>>        End
39658>>>>
39658>>>        
39658>>>        //  Redirect to a specific operation based on the path
39658>>>        If (Lowercase(aPath[1]) = "centros") Begin
39660>>>            If (SizeOfArray(aPath) > 2 and aPath[2] <> "") Begin
39662>>>                Send SetResponseStatus 401 "Only use POST for creating new resources"
39663>>>            End
39663>>>>
39663>>>            Else Begin
39664>>>                Send CrearCentro True ""
39665>>>            End
39665>>>>
39665>>>        End
39665>>>>
39665>>>        Else Begin
39666>>>            Send SetResponseStatus 404 "Unknown resource"
39667>>>        End
39667>>>>
39667>>>    
39667>>>    End_Procedure
39668>>>    
