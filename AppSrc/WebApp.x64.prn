38137>>>>>>>>>>>Class cHttpTransfer is a cBaseHttpTransfer
38138>>>>>>>>>>>    
38138>>>>>>>>>>>    Function HttpPostRequest String sFilePath String sData Integer bDataIsFile Returns Integer
38140>>>>>>>>>>>        Integer bStat
38140>>>>>>>>>>>        Get HttpPostAddrRequest sFilePath (AddressOf(sData)) (SizeOfString(sData)) bDataIsfile to bStat
38141>>>>>>>>>>>        Function_Return bStat
38142>>>>>>>>>>>    End_Function
38143>>>>>>>>>>>    
38143>>>>>>>>>>>    // This event is triggered from the runtime. It now uses UChar arrays as the data might 
38143>>>>>>>>>>>    // not be a valid string (it can be any binary data). It still calls the original event for 
38143>>>>>>>>>>>    // backwards compatibility.
38143>>>>>>>>>>>    Procedure OnDataReceivedUC String sContentType UChar[] ucData
38145>>>>>>>>>>>        Send OnDataReceived sContentType (UCharArrayToString(ucData))
38146>>>>>>>>>>>    End_Procedure
38147>>>>>>>>>>>    
38147>>>>>>>>>>>    // Only use this event if you know for sure the data is a string and make sure piBufferSize is
38147>>>>>>>>>>>    // smaller than the argument size.
38147>>>>>>>>>>>    Procedure OnDataReceived String sContentType String sData
38149>>>>>>>>>>>        
38149>>>>>>>>>>>    End_Procedure
38150>>>>>>>>>>>    
38150>>>>>>>>>>>    // Called just before the request is sent. Use this message to set options to the RequestHandle if nessecary.
38150>>>>>>>>>>>    Procedure OnPreSendRequest 
38152>>>>>>>>>>>        
38152>>>>>>>>>>>    End_Procedure
38153>>>>>>>>>>>    
38153>>>>>>>>>>>    Function HttpPutRequest String sFilePath String sData Integer bDataIsFile Returns Integer
38155>>>>>>>>>>>        Integer bStat
38155>>>>>>>>>>>        Get HttpPutAddrRequest sFilePath (AddressOf(sData)) (SizeOfString(sData)) bDataIsfile to bStat
38156>>>>>>>>>>>        Function_Return bStat
38157>>>>>>>>>>>    End_Function
38158>>>>>>>>>>>    
38158>>>>>>>>>>>    // Retrieve header information associated with the previous request.
38158>>>>>>>>>>>    Function QueryInfo DWord dwInfoLevel Returns String
38160>>>>>>>>>>>        Handle hRequestHandle
38160>>>>>>>>>>>        WString wResult
38160>>>>>>>>>>>        Integer iBufferSize iRes iVoid
38160>>>>>>>>>>>
38160>>>>>>>>>>>        Get RequestHandle to hRequestHandle
38161>>>>>>>>>>>        
38161>>>>>>>>>>>        If (hRequestHandle) Begin
38163>>>>>>>>>>>            Move 200 to iBufferSize
38164>>>>>>>>>>>            Move (Repeat(" ", iBufferSize)) to wResult
38165>>>>>>>>>>>            Move (WinAPI_HttpQueryInfo(hRequestHandle, dwInfoLevel, AddressOf(wResult), AddressOf(iBufferSize), 0)) to iRes
38166>>>>>>>>>>>            
38166>>>>>>>>>>>            If (not(iRes) and GetLastError() = 122) Begin //  Insufficient buffersize, retry with received iBufferSize value
38168>>>>>>>>>>>                Increment iBufferSize      
38169>>>>>>>>>>>                
38169>>>>>>>>>>>                Move (Repeat(" ", iBufferSize)) to wResult
38170>>>>>>>>>>>                Move (WinAPI_HttpQueryInfo(hRequestHandle, dwInfoLevel, AddressOf(wResult), AddressOf(iBufferSize), 0)) to iRes  
38171>>>>>>>>>>>            End
38171>>>>>>>>>>>>
38171>>>>>>>>>>>            
38171>>>>>>>>>>>            If (not(iRes)) Begin
38173>>>>>>>>>>>                Move (ShowLastError()) to iVoid
38174>>>>>>>>>>>            End
38174>>>>>>>>>>>>
38174>>>>>>>>>>>        End
38174>>>>>>>>>>>>
38174>>>>>>>>>>>        
38174>>>>>>>>>>>        Function_Return (CString(wResult))
38175>>>>>>>>>>>    End_Function
38176>>>>>>>>>>>    
38176>>>>>>>>>>>    // Returns the statustext returned by the previous request.
38176>>>>>>>>>>>    Function ResponseStatusText Returns String
38178>>>>>>>>>>>        String sStatus
38178>>>>>>>>>>>        
38178>>>>>>>>>>>        Get QueryInfo HTTP_QUERY_STATUS_TEXT to sStatus
38179>>>>>>>>>>>        
38179>>>>>>>>>>>        Function_Return sStatus
38180>>>>>>>>>>>    End_Function
38181>>>>>>>>>>>    
38181>>>>>>>>>>>End_Class
