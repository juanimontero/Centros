36986>>>>>>>End_Class
36987>>>>>
36987>>>>>Class cWebSessionManagerStandard is a cWebSessionManager
36988>>>>>    
36988>>>>>    Procedure Construct_Object
36990>>>>>        Handle hoObj
36990>>>>>        
36990>>>>>        Forward Send Construct_Object
36992>>>>>        
36992>>>>>        Set pbSessionCookieHttpOnly to True
36993>>>>>        
36993>>>>>        Property Handle phoUserDD 0      // Handle to the WebAppUser DDO
36994>>>>>        Property Handle phoSessionDD 0   // Handle to the WebAppSession DDO  
36995>>>>>        Property Handle phoCrypto 0      // Handle to the PasswordHasher
36996>>>>>        
36996>>>>>        Get CreateNamed (RefClass(cWebAppUserDataDictionary)) 'oUserDD' to hoObj
36997>>>>>        Set phoUserDD to hoObj
36998>>>>>        
36998>>>>>        Get CreateNamed (RefClass(cWebAppSessionDataDictionary)) 'oSessionDD' to hoObj
36999>>>>>        Set DDO_Server of hoObj to (phoUserDD(Self))
37000>>>>>        Set phoSessionDD to hoObj
37001>>>>>        
37001>>>>>        Property Handle phoCrypto 0   // Handle to the Cryptographer
37002>>>>>        Get CreateNamed (RefClass(cPasswordHasher)) 'oCrypto' to hoObj
37003>>>>>        Set phoCrypto to hoObj
37004>>>>>        
37004>>>>>        Property Boolean pbPasswordHashing True
37005>>>>>        
37005>>>>>        Property Boolean pbCreatingNewSession False
37006>>>>>        Property String psLoginName
37007>>>>>        Property String psUserName ""
37008>>>>>        Property Integer piUserRights 0
37009>>>>>    End_Procedure
37010>>>>>    
37010>>>>>    Procedure End_Construct_Object
37012>>>>>        Forward Send End_Construct_Object
37014>>>>>        
37014>>>>>        Handle hoCrypto
37014>>>>>        Integer iFieldLen
37014>>>>>        If (pbPasswordHashing(Self)) Begin
37016>>>>>            Get phoCrypto to hoCrypto
37017>>>>>            Get_Attribute DF_FIELD_LENGTH of (RefTable(WebAppUser)) (RefTable(WebAppUser.Password)) to iFieldLen
37020>>>>>            If (iFieldLen < (RequiredBufferSize(hoCrypto) + 3)) Begin
37022>>>>>                Error DFERR_PROGRAM "The password field of WebAppUser is not large enough (128)"
37023>>>>>>
37023>>>>>            End
37023>>>>>>
37023>>>>>        End
37023>>>>>>
37023>>>>>    End_Procedure
37024>>>>>    
37024>>>>>    Function CreateSession String sRemoteAddress Returns String
37026>>>>>        String sSessionKey
37026>>>>>        Integer iErr
37026>>>>>        Boolean bLogWebSession
37026>>>>>        Handle hoSessionDD       
37026>>>>>        Get phoSessionDD to hoSessionDD
37027>>>>>        
37027>>>>>        //  Get session key
37027>>>>>        Forward Get CreateSession sRemoteAddress to sSessionKey
37029>>>>>        
37029>>>>>        Get pbLogWebSession to bLogWebSession
37030>>>>>        If not bLogWebSession Begin
37032>>>>>            Function_Return sSessionKey        
37033>>>>>        End
37033>>>>>>
37033>>>>>
37033>>>>>        //  Store session
37033>>>>>        Send Clear of hoSessionDD
37034>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.SessionKey to sSessionKey
37035>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.RemoteAddress to sRemoteAddress
37036>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "Y"
37037>>>>>        Get Request_Validate of hoSessionDD to iErr
37038>>>>>        If (iErr) Begin
37040>>>>>            // this should not happen. If it does its a programming error
37040>>>>>            Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37041>>>>>>
37041>>>>>            Function_Return ""
37042>>>>>        End
37042>>>>>>
37042>>>>>        Send Request_Save of hoSessionDD
37043>>>>>        If (Err) Begin
37045>>>>>            // this shouldn't happen, if it does likely a duplicate session key issue, even through request_save already gave an error we give another one to make tracking down easier
37045>>>>>            Error DFERR_PROGRAM C_$WebAppSessionSaveFailed
37046>>>>>>
37046>>>>>            Function_Return ""
37047>>>>>        End
37047>>>>>>
37047>>>>>       
37047>>>>>        Function_Return sSessionKey        
37048>>>>>    End_Function
37049>>>>>    
37049>>>>>    Function ValidateSession String sSessionKey Boolean bOptLoadWebApp Returns Boolean
37051>>>>>        DateTime dtLastAccess dtCurrent
37051>>>>>        TimeSpan tsDiff
37051>>>>>        Integer iErr iSessionTimeout iSpanMinutes
37051>>>>>        Boolean bResult bCreatingNewSession
37051>>>>>        Boolean bLogWebSession bLoadWebApp
37051>>>>>        Integer eLoginMode
37051>>>>>        String sTime
37051>>>>>        Handle hoSessionDD hoUserDD       
37051>>>>>        
37051>>>>>        Move False to bLoadWebApp
37052>>>>>        If (num_arguments >= 2) Begin
37054>>>>>            Move bOptLoadWebApp to bLoadWebApp
37055>>>>>        End
37055>>>>>>
37055>>>>>        
37055>>>>>        Get phoSessionDD to hoSessionDD
37056>>>>>        Get phoUserDD to hoUserDD
37057>>>>>        
37057>>>>>        Get pbLogWebSession to bLogWebSession
37058>>>>>        Get peLoginMode to eLoginMode
37059>>>>>        
37059>>>>>        // for this object, you can only disable logging if login completely is disabled
37059>>>>>        If (not(bLogWebSession) and (eLoginMode<>lmLoginNone)) Begin
37061>>>>>            Error DFERR_PROGRAM C_$WebSessionLoggingMustBeEnabled
37062>>>>>>
37062>>>>>            Function_Return False
37063>>>>>        End
37063>>>>>>
37063>>>>>
37063>>>>>        //  Clear session properties
37063>>>>>        Set psSessionKey to ""
37064>>>>>        Send UpdateSessionProperties True
37065>>>>>        
37065>>>>>        If not bLogWebSession Begin
37067>>>>>            Forward Get ValidateSession sSessionKey to bResult
37069>>>>>            Function_Return bResult
37070>>>>>        End        
37070>>>>>>
37070>>>>>        
37070>>>>>        Move False to bResult
37071>>>>>        Get piSessionTimeout to iSessionTimeout 
37072>>>>>        
37072>>>>>        //  Check if session exists
37072>>>>>        Send Clear of hoSessionDD
37073>>>>>        Move sSessionKey to WebAppSession.SessionKey
37074>>>>>        Send Find of hoSessionDD EQ Index.1
37075>>>>>            
37075>>>>>        If (Found) Begin
37077>>>>>            //  Calculate timespan between now and last access time
37077>>>>>            Move (CurrentDateTime()) to dtCurrent
37078>>>>>            Move WebAppSession.LastAccessDate to dtLastAccess
37079>>>>>            Get StringToTime of hoSessionDD dtLastAccess WebAppSession.LastAccessTime to dtLastAccess
37080>>>>>            Move (dtCurrent - dtLastAccess) to tsDiff
37081>>>>>            Move (SpanTotalMinutes(tsDiff)) to iSpanMinutes
37082>>>>>            
37082>>>>>            //  Check if session didn't time out
37082>>>>>            If (IsDateValid(dtLastAccess) and (iSessionTimeout <= 0 or (iSpanMinutes < iSessionTimeout)) and WebAppSession.Active = "Y") Begin
37084>>>>>                Forward Get ValidateSession sSessionKey to bResult
37086>>>>>                   
37086>>>>>                If (bResult) Begin
37088>>>>>                    //  Update session record
37088>>>>>                    Get TimeToString of hoSessionDD dtCurrent to sTime 
37089>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessDate to dtCurrent
37090>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessTime to sTime
37091>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.UseCount to (WebAppSession.UseCount + 1)
37092>>>>>                    Get Request_Validate of hoSessionDD to iErr
37093>>>>>                    If (iErr) Begin
37095>>>>>                        // this should not happen. If it does its a programming error
37095>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37096>>>>>>
37096>>>>>                        Function_Return False
37097>>>>>                    End
37097>>>>>>
37097>>>>>                    Send Request_Save of hoSessionDD
37098>>>>>                    
37098>>>>>                    //  Update user properties
37098>>>>>                    Send UpdateSessionProperties False
37099>>>>>                End
37099>>>>>>
37099>>>>>            End
37099>>>>>>
37099>>>>>            Else Begin
37100>>>>>                // Test the Creating New Session Flag to protect against infinite recursion....
37100>>>>>                Get pbCreatingNewSession to bCreatingNewSession
37101>>>>>                
37101>>>>>                If (not(bCreatingNewSession)) Begin
37103>>>>>                    If (not(bLoadWebApp)) Begin
37105>>>>>                        Move False to bResult   //  We can only continue immediately if we were loading the webapp, other operations are not allowed!
37106>>>>>                        Error DFERR_WEBAPP_SESSION_TIMEOUT "Your application session has timed out or is inactive, please login again."
37107>>>>>>
37107>>>>>                        Send NavigateRefresh of ghoWebApp          // refresh the WebApp at the client (triggers a login)
37108>>>>>                    End
37108>>>>>>
37108>>>>>                    Else Begin
37109>>>>>                        Set pbCreatingNewSession to True                    
37110>>>>>                        Get RecreateSession of ghoWebApp to bResult 
37111>>>>>                        Set pbCreatingNewSession to False                        
37112>>>>>                    End
37112>>>>>>
37112>>>>>                End
37112>>>>>>
37112>>>>>            End
37112>>>>>>
37112>>>>>        End
37112>>>>>>
37112>>>>>        Else Begin
37113>>>>>            Error DFERR_WEBAPP_BAD_SESSION_KEY "Session key not known (reload page to recreate session)"
37114>>>>>>
37114>>>>>        End
37114>>>>>>
37114>>>>>        
37114>>>>>        Function_Return bResult
37115>>>>>    End_Function
37116>>>>>    
37116>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
37118>>>>>        If (not(pbPasswordHashing(Self))) Begin
37120>>>>>            Move sPassword to sHash
37121>>>>>            Function_Return True
37122>>>>>        End
37122>>>>>>
37122>>>>>        
37122>>>>>        If (not(CreatePasswordHash(phoCrypto(Self), sPassword, &sHash))) Begin
37124>>>>>            Function_Return False
37125>>>>>        End
37125>>>>>>
37125>>>>>        Move ("V1$" + sHash) to sHash
37126>>>>>        Function_Return True
37127>>>>>    End_Function
37128>>>>>    
37128>>>>>    Function VerifyPasswordHash String sUserPassword String sEnteredPassword Boolean ByRef bShouldUpgrade Returns Boolean
37130>>>>>        If (not(pbPasswordHashing(Self))) Begin
37132>>>>>            Move False to bShouldUpgrade
37133>>>>>            Function_Return (sUserPassword = sEnteredPassword)
37134>>>>>        End
37134>>>>>>
37134>>>>>        
37134>>>>>        String sVersion
37134>>>>>        Move (Left(sUserPassword, 3)) to sVersion
37135>>>>>        If (sVersion = "V1$") Begin
37137>>>>>            If (num_arguments > 2) Move False to bShouldUpgrade
37140>>>>>            Function_Return (VerifyPasswordHash(phoCrypto(Self), sEnteredPassword, Right(sUserPassword, Length(sUserPassword) - 3)))
37141>>>>>        End
37141>>>>>>
37141>>>>>        Else Begin
37142>>>>>            If (num_arguments > 2) Move True to bShouldUpgrade
37145>>>>>            Function_Return False
37146>>>>>        End
37146>>>>>>
37146>>>>>    End_Function
37147>>>>>    
37147>>>>>    Function UserRegister String sLoginName String sPassword Returns Boolean
37149>>>>>        Handle hoUserDD
37149>>>>>        Integer iErr
37149>>>>>        Get phoUserDD to hoUserDD
37150>>>>>        
37150>>>>>        //  Find the user
37150>>>>>        Send Clear of hoUserDD
37151>>>>>        Move sLoginName to WebAppUser.LoginName
37152>>>>>        Send Find of hoUserDD EQ Index.1
37153>>>>>        If (Found) Begin
37155>>>>>            Send Clear of hoUserDD
37156>>>>>            Function_Return False
37157>>>>>        End
37157>>>>>>
37157>>>>>        
37157>>>>>        Send Clear of hoUserDD
37158>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.FullName to sLoginName
37159>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.LoginName to sLoginName
37160>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
37162>>>>>            Send Clear of hoUserDD
37163>>>>>            Function_Return False
37164>>>>>        End
37164>>>>>>
37164>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37165>>>>>        Get Request_Validate of hoUserDD to iErr
37166>>>>>        If (iErr) Begin
37168>>>>>            Send Clear of hoUserDD
37169>>>>>            Function_Return False
37170>>>>>        End
37170>>>>>>
37170>>>>>        
37170>>>>>        Send Request_Save of hoUserDD
37171>>>>>        Function_Return (not(Err))
