39554>    Use StatusAPI.wo
Including file: StatusAPI.wo    (C:\DataFlex Projects\Centros\AppSrc\StatusAPI.wo)
39554>>>Use cWebHttpHandler.pkg
39554>>>
39554>>>Object oSimpleHTTPHandler is a cWebHttpHandler
39556>>>    Set psPath to "Status"
39557>>>    Set psVerbs to "GET"
39558>>>
39558>>>    Procedure OnHttpGet String sPath String sAcceptType
39561>>>        String sCode 
39561>>>        Integer iStatusActual
39561>>>        Get UrlParameter "Code" to sCode
39562>>>  
39562>>>        Case Begin
39562>>>            Case (sCode = "200")
39564>>>                Send SetResponseStatus 200 "OK" 0
39565>>>            Case Break
39566>>>            
39566>>>            Case (sCode = "202")
39569>>>                Send SetResponseStatus 202 "Accepted" 0
39570>>>            Case Break
39571>>>            
39571>>>            Case (sCode = "302")
39574>>>                Send SetResponseStatus 302 "Found" 0
39575>>>            Case Break
39576>>>            
39576>>>            Case (sCode = "307")
39579>>>                Send SetResponseStatus 307 "Temporary Redirect" 0
39580>>>            Case Break
39581>>>            
39581>>>            Case (sCode = "404")
39584>>>                Send SetResponseStatus 404 "Not found" 0
39585>>>            Case Break
39586>>>            
39586>>>            Case (sCode = "406")
39589>>>                Send SetResponseStatus 406 "Not Acceptable" 0
39590>>>            Case Break
39591>>>            
39591>>>            Case (sCode = "500")
39594>>>                Send SetResponseStatus 500 "Internal Servel Error" 0
39595>>>            Case Break
39596>>>            
39596>>>            Case (sCode = "508")
39599>>>                Send SetResponseStatus 508 "Loop detected" 0
39600>>>            Case Break
39601>>>        
39601>>>        
39601>>>        Case End   
39601>>>        
39601>>>    //----
39601>>>        Send AddHttpResponseHeader "Content-Type" "text/html"
39602>>>        Send OutputString '<html>'
39603>>>        Send OutputString '<head><title>Status</title></head>'
39604>>>        Send OutputString (SFormat('<body><h1>Status =  %1!</h1></body>', sCode))
39605>>>        Send OutputString '</html>'
39606>>>        
39606>>>        
39606>>>                
39606>>>    End_Procedure
39607>>>End_Object
