39467>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
39470>>>        WebSet pbRender of oNewButton to True
39471>>>        WebSet pbRender of oDetailButton to True
39472>>>
39472>>>        Case Begin
39472>>>            Case (NavigateData.eNavigateType = nfFromParent)
39474>>>                // If from parent, this is a constrained drill down
39474>>>                Case Break
39475>>>
39475>>>            Case (NavigateData.eNavigateType = nfFromChild)
39478>>>                // If from child, this is a probably a parent lookup from a Zoom
39478>>>                Case Break
39479>>>
39479>>>            Case (NavigateData.eNavigateType = nfFromMain)
39482>>>                // If from main, this is a probably a main-file lookup from a Zoom
39482>>>                WebSet pbRender of oDetailButton to False
39483>>>                Case Break
39484>>>
39484>>>            Case Else // must be nfUndefined
39484>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
39484>>>
39484>>>        Case End
39484>>>
39484>>>    End_Procedure
