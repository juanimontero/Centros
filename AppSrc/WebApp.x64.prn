38327>>>>>>>>>    
38327>>>>>>>>>    // After an Json xfer request this message can be sent to display an error message if one occurred.
38327>>>>>>>>>    // Normally you would first check peJsonTransferStatus to see if it is not jtsOk. If not, send
38327>>>>>>>>>    // LastError to see the error
38327>>>>>>>>>    
38327>>>>>>>>>    // return last JSON transfer error text
38327>>>>>>>>>    Function TransferErrorDescription Returns String
38329>>>>>>>>>        String  sError sJsonError
38329>>>>>>>>>        Integer eJsonTransferStatus
38329>>>>>>>>>        Get peJsonTransferStatus to eJsonTransferStatus
38330>>>>>>>>>        Get psJsonParseError to sJsonError
38331>>>>>>>>>        Case Begin
38331>>>>>>>>>            Case (eJsonTransferStatus=jtsOk) ;                Move '' to sError
38334>>>>>>>>>            Case (eJsonTransferStatus=jtsHttpRequestFailed) ;                Move C_$HttpRequestFailed to sError
38338>>>>>>>>>            Case (eJsonTransferStatus=jtsInvalidContentType) ;                Move (SFormat(C_$InvalidContentTypeReceived,psContentTypeReceived(Self))) to sError
38342>>>>>>>>>            Case (eJsonTransferStatus=jtsNotJson) ;                Move (C_$ReceivedDataNotInJsonFormat * sJsonError) to sError
38346>>>>>>>>>            Case Else ;                Move C_$ReceivedDataIsBad to sError
38348>>>>>>>>>        Case End
38348>>>>>>>>>        Function_Return sError
38349>>>>>>>>>    End_Function
38350>>>>>>>>>    
38350>>>>>>>>>    // can be send to raise an error.
38350>>>>>>>>>    Procedure LastError
38352>>>>>>>>>        Integer eJsonTransferStatus
38352>>>>>>>>>        String sError
38352>>>>>>>>>        
38352>>>>>>>>>        Get peJsonTransferStatus to eJsonTransferStatus
38353>>>>>>>>>        If (eJsonTransferStatus<>jtsOk) Begin
38355>>>>>>>>>            Get TransferErrorDescription to sError
38356>>>>>>>>>            Error DFERR_JSON_HTTP sError
38357>>>>>>>>>>
38357>>>>>>>>>        End
38357>>>>>>>>>>
38357>>>>>>>>>    End_Procedure
38358>>>>>>>>>    
38358>>>>>>>>>    
38358>>>>>>>>>End_Class
38359>>>>>>>
38359>>>>>>>
38359>>>>>>>Function zTelefonoValidation Boolean bUseApi String sPrefijo String sTelefono  String ByRef sMsg Returns Boolean
38362>>>>>>>     Boolean bRet    
38362>>>>>>>//-------------------LLamada a Validacion basica-------------------       
38362>>>>>>>     Get zNumeroCorrecto sTelefono (&sMsg) to bRet
38363>>>>>>>     If (not(bRet)) Function_Return False 
38366>>>>>>>//-------------------LLamada a Api-------------------     
38366>>>>>>>     If (bUseApi) Get zValidarConApi sTelefono sPrefijo (&sMsg) to bRet
38369>>>>>>>     If (not(bRet)) Function_Return False
38372>>>>>>>//-------------------Si todo ha salido bien retorna true-------------------      
38372>>>>>>>    Function_Return True
38373>>>>>>>End_Function
38374>>>>>>>
38374>>>>>>>Function zNumeroCorrecto String sTelefono String ByRef sMsg Returns Boolean
38377>>>>>>>    String[] aRet
38378>>>>>>>//-------------------Expresion regular para cualquier formato internacional de telefono-------------------  
38378>>>>>>>    Object oTelefonopattern is a cRegEx
38380>>>>>>>        Set psExpression to "^(?:[-\s])?\d(?:[\d\s-]*\d)?(?:[-\s])?$"
38381>>>>>>>    End_Object
38382>>>>>>>    Get MatchAll of oTelefonopattern (sTelefono) to aRet
38383>>>>>>>        If (SizeOfArray(aRet) = 1) Begin
38385>>>>>>>            Function_Return True
38386>>>>>>>        End
38386>>>>>>>>
38386>>>>>>>    Move "Porfavor Introduzca un formato de Telefono valido" to sMsg
38387>>>>>>>    Function_Return False    
38388>>>>>>>End_Function 
38389>>>>>>>
38389>>>>>>>Function zValidarConApi String sTelefono String sPrefijo String ByRef sMsg Returns Boolean    
38392>>>>>>>    Handle hoJsonReceived hoHttp
38392>>>>>>>    Boolean bOk bIsNull bRet
38392>>>>>>>    String  sNum sUrl
38392>>>>>>>     // ----
38392>>>>>>>    Move (sPrefijo + sTelefono) to sNum   
38393>>>>>>>    Get Create (RefClass(cJsonHttpTransfer)) to hoHttp
38394>>>>>>>    Move False to bRet
38395>>>>>>>//-------------------LLamada a Api-------------------      
38395>>>>>>>    Get HttpGetJson of hohttp ("phonevalidation.abstractapi.com") ("/v1/?api_key=713383f7f21e45b1ac4054a472e00971&phone=" + sNum) (&bOk) to hoJsonReceived
38396>>>>>>>//-------------------Lanza un mensaje de error si la llamada a fallado-------------------      
38396>>>>>>>    If (not(bOk)) Move "La llamada a la Api ha fallado" to sMsg
38399>>>>>>>//-------------------LLamada a Api-------------------  
38399>>>>>>>    If (bOk = True and ResponseStatusCode(hohttp) = 200 and hoJsonReceived <> 0) Begin        
38401>>>>>>>        If (HasMember(hoJsonReceived,"valid"))  Begin
38403>>>>>>>            Get IsMemberOfJsonType of hoJsonReceived "valid" jsonTypeNull  to bIsNull
38404>>>>>>>            If bIsNull  Move False to bRet
38407>>>>>>>            Else Move (MemberValue(hoJsonReceived,"valid")) to bRet
38409>>>>>>>        End
38409>>>>>>>>
38409>>>>>>>//-------------------Lanza un mensaje de error si No existe ese número-------------------          
38409>>>>>>>        If (not(bRet)) Move "No es valido el dni" to sMsg
38412>>>>>>>    End
38412>>>>>>>>
38412>>>>>>>    Send Destroy of hohttp
38413>>>>>>>    Function_Return bRet
38414>>>>>>>End_Function
38415>>>>>>>    
