39668>>>    Procedure ListaCentros
39671>>>        Handle hoJson hoCentro
39671>>>
39671>>>        Get Create (RefClass(cJsonObject)) to hoJson
39672>>>        Send InitializeJsonType of hoJson jsonTypeArray
39673>>>
39673>>>        Get Create (RefClass(cJsonObject)) to hoCentro
39674>>>
39674>>>        Send Find of oCentros_DD FIRST_RECORD 1
39675>>>        While (Found)
39679>>>            Send InitializeJsonType of hoCentro jsonTypeObject
39680>>>
39680>>>            Send SetMemberValue of hoCentro "Id" jsonTypeInteger Centros.Id
39681>>>            Send SetMemberValue of hoCentro "Nombre" jsonTypeString Centros.Nombre
39682>>>            Send SetMemberValue of hoCentro "PsNombre" jsonTypeString Centros.PsNombre
39683>>>            Send AddMember of hoJson hoCentro
39684>>>
39684>>>            Send Find of oCentros_DD NEXT_RECORD 1
39685>>>        Loop
39686>>>>
39686>>>
39686>>>        Send OutputJson hoJson
39687>>>
39687>>>        Send Destroy of hoCentro
39688>>>        Send Destroy of hoJson
39689>>>    End_Procedure
