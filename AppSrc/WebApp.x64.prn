37173>>>>>    
37173>>>>>    Function UserLogin String sLoginName String sPassword Returns Boolean
37175>>>>>        String sSessionKey sUserPassword
37175>>>>>        Handle hoSessionDD hoUserDD
37175>>>>>        Boolean bMatch bUpgrade
37175>>>>>        
37175>>>>>        Get phoSessionDD to hoSessionDD
37176>>>>>        Get phoUserDD to hoUserDD
37177>>>>>        Integer iErr eLoginMode
37177>>>>>        
37177>>>>>        // Refind session record
37177>>>>>        Get psSessionKey to sSessionKey
37178>>>>>        Send Clear of hoSessionDD
37179>>>>>        Move sSessionKey to WebAppSession.SessionKey
37180>>>>>        Send Find of hoSessionDD EQ Index.1
37181>>>>>        
37181>>>>>        If (Found and WebAppSession.SessionKey = sSessionKey) Begin
37183>>>>>            Get peLoginMode to eLoginMode
37184>>>>>            
37184>>>>>            //  Find the user
37184>>>>>            Move sLoginName to WebAppUser.LoginName
37185>>>>>            Send Find of hoUserDD EQ Index.1
37186>>>>>            
37186>>>>>            // Check username and password
37186>>>>>            If (Found and (Lowercase(sLoginName) = Lowercase(Trim(WebAppUser.LoginName)))) Begin
37188>>>>>                Get Field_Current_Value of hoUserDD Field WebAppUser.Password to sUserPassword
37189>>>>>                Get VerifyPasswordHash (Trim(sUserPassword)) (Trim(sPassword)) (&bUpgrade) to bMatch
37190>>>>>                
37190>>>>>                If (bMatch) Begin
37192>>>>>                    // Store the login
37192>>>>>                    If (bUpgrade) Begin
37194>>>>>                        Get CreatePasswordHash (Trim(sPassword)) (&sPassword) to bUpgrade
37195>>>>>                        If (bUpgrade) Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37198>>>>>                    End
37198>>>>>>
37198>>>>>                    Set Field_Changed_Value of hoUserDD Field WebAppUser.LastLogin to (CurrentDateTime())
37199>>>>>                    Get Request_Validate of hoSessionDD to iErr
37200>>>>>                    If (iErr) Begin
37202>>>>>                        // this should not happen. If it does its a programming error
37202>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37203>>>>>>
37203>>>>>                        Function_Return False
37204>>>>>                    End
37204>>>>>>
37204>>>>>                    
37204>>>>>                    Send Request_Save of hoSessionDD
37205>>>>>                    
37205>>>>>                    // Update session properties
37205>>>>>                    Send UpdateSessionProperties False
37206>>>>>                    Send NotifyChangeRights
37207>>>>>                    Function_Return True
37208>>>>>                End
37208>>>>>>
37208>>>>>                Else Begin
37209>>>>>                    //  We should rely directly on this buffer elsewhere but just be sure
37209>>>>>                    Send Clear of hoUserDD
37210>>>>>                End
37210>>>>>>
37210>>>>>            End
37210>>>>>>
37210>>>>>            Else Begin
37211>>>>>                // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37211>>>>>                Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37212>>>>>            End
37212>>>>>>
37212>>>>>        End
37212>>>>>>
37212>>>>>        Else Begin
37213>>>>>            // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37213>>>>>            Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37214>>>>>        End
37214>>>>>>
37214>>>>>          
37214>>>>>        Function_Return False
37215>>>>>    End_Function
