38855>>>    Procedure SetActionButtons
38858>>>        tWebNavigateData NavigateData
38858>>>        tWebNavigateData NavigateData
38858>>>        Boolean bHasRecord
38858>>>        Handle hoDD
38858>>>
38858>>>        Get Server to hoDD
38859>>>        Get GetNavigateData to NavigateData
38860>>>        Get HasRecord of hoDD to bHasRecord
38861>>>
38861>>>        // let's hide all buttons and then Show the ones we want
38861>>>        WebSet pbRender of oEditBtn to False
38862>>>        WebSet pbRender of oSaveBtn to False
38863>>>        WebSet pbRender of oCancelChangesBtn to False
38864>>>        WebSet pbRender of oDeleteBtn to False
38865>>>
38865>>>        If (NavigateData.bReadOnly) Begin
38867>>>            WebSet pbRender of oEditBtn to True
38868>>>        End
38868>>>>
38868>>>        Else Begin
38869>>>            WebSet pbRender of oSaveBtn to True
38870>>>            WebSet pbRender of oCancelChangesBtn to True
38871>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38872>>>        End
38872>>>>
38872>>>    End_Procedure
