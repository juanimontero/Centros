39802>>>        //  Helper function that reads an entire request into a JSON object.
39802>>>    Function RequestDataJson Handle ByRef hoJson Returns Boolean
39805>>>        UChar[] ucData
39806>>>        Boolean bSuccess
39806>>>        String sErr
39806>>>        
39806>>>        Get Create (RefClass(cJsonObject)) to hoJson
39807>>>        
39807>>>        Get RequestDataUChar -1 to ucData
39808>>>        Get ParseUtf8 of hoJson ucData to bSuccess
39809>>>        
39809>>>        If (not(bSuccess)) Begin
39811>>>            Get psParseError of hoJson to sErr
39812>>>            Send SetResponseStatus 402 sErr
39813>>>        End
39813>>>>
39813>>>        
39813>>>        Function_Return bSuccess
39814>>>    End_Function
39815>>>    
39815>>>    
39815>>>      Procedure ErrorReportJson
39818>>>        Integer iErr iErrC
39818>>>        Handle hoJson hoErrors   
39818>>>        String sMessage
39818>>>        
39818>>>        Get ErrorCount to iErrC
39819>>>        If (iErrC > 0) Begin
39821>>>            Send SetResponseStatus 403 "Errors occurred"
39822>>>            
39822>>>            Get Create (RefClass(cJsonObject)) to hoJson
39823>>>            Send InitializeJsonType of hoJson jsonTypeObject
39824>>>            
39824>>>            Get Create (RefClass(cJsonObject)) to hoErrors
39825>>>            Send InitializeJsonType of hoErrors jsonTypeArray
39826>>>            
39826>>>            For iErr from 0 to (iErrC - 1)
39832>>>>
39832>>>                Get ErrorMessage iErr to sMessage
39833>>>                Send AddMemberValue of hoErrors jsonTypeString  sMessage
39834>>>            Loop
39835>>>>
39835>>>            
