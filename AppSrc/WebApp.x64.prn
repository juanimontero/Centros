38883>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38886>>>        Case Begin
38886>>>            Case (NavigateData.eNavigateType = nfFromMain)
38888>>>                // If from main, this is a propbably a main file Select to Zoom.
38888>>>                
38888>>>                 Boolean bHasRecord
38888>>>                    Get HasRecord of oAlumnos_DD to bHasRecord
38889>>>                    
38889>>>                    If bHasRecord Begin
38891>>>                        Send SetBreadCrumbCaption (Trim(Alumnos.Nombre +" "+ Alumnos.Apellidos))
38892>>>                        Send SetHeaderCaption (Trim(Alumnos.Nombre +" "+ Alumnos.Apellidos))
38893>>>                    End
38893>>>>
38893>>>                Case Break
38894>>>
38894>>>            Case (NavigateData.eNavigateType = nfFromParent)
38897>>>                // If from parent, this is a constrained drill down.
38897>>>                Case Break
38898>>>
38898>>>            Case (NavigateData.eNavigateType = nfFromChild)
38901>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38901>>>                Case Break
38902>>>
38902>>>            Case Else // must be nfUndefined
38902>>>
38902>>>        Case End
38902>>>
38902>>>        Send SetActionButtons
38903>>>
38903>>>    End_Procedure
