36781>>>>>>>Class cPasswordHasher_Mixin is a Mixin
36782>>>>>>>    
36782>>>>>>>    Import_Class_Protocol cPasswordHasher_CNG_PBKDF2_HMAC_Mixin
36783>>>>>>>    
36783>>>>>>>    Enum_List // Algorithmes available for password hashing
36783>>>>>>>        Define C_PWH_PBKDF2_HMAC_SHA_256        for 0 // Requires TimeCost
36783>>>>>>>        Define C_PWH_PBKDF2_HMAC_SHA_512              // Requires TimeCost
36783>>>>>>>    End_Enum_List
36783>>>>>>>    
36783>>>>>>>    Function RandomBuffer UInteger uiSize Returns UChar[]
36785>>>>>>>        UChar[] ucaBuffer
36786>>>>>>>        Move (ResizeArray(ucaBuffer, uiSize)) to ucaBuffer
36787>>>>>>>        If (CNG_BCryptGenRandom(0, AddressOf(ucaBuffer), uiSize, |CI$00000002 /*BCRYPT_USE_SYSTEM_PREFERRED_RNG*/)) Begin
36789>>>>>>>            Error 8710 "Failed to create random buffer."
36790>>>>>>>>
36790>>>>>>>        End
36790>>>>>>>>
36790>>>>>>>        Function_Return ucaBuffer
36791>>>>>>>    End_Function
36792>>>>>>>    
36792>>>>>>>    Function Base64EncodeArr UChar[] ucaBuffer Returns String
36794>>>>>>>        Integer iErr
36794>>>>>>>        Pointer pBase64
36794>>>>>>>        String sBase64
36794>>>>>>>        Move (Base64Encode(AddressOf(ucaBuffer), SizeOfArray(ucaBuffer))) to pBase64
36795>>>>>>>        If (not(pBase64)) Begin
36797>>>>>>>            Function_Return sBase64
36798>>>>>>>        End
36798>>>>>>>>
36798>>>>>>>        Move (PointerToString(pBase64)) to sBase64
36799>>>>>>>        Move (Free(pBase64)) to iErr
36800>>>>>>>        Function_Return sBase64
36801>>>>>>>    End_Function
36802>>>>>>>    
36802>>>>>>>    Function Base64DecodeArr String sBase64 Returns UChar[]
36804>>>>>>>        Integer iLen
36804>>>>>>>        Pointer pBase64
36804>>>>>>>        UChar[] ucaBuffer
36805>>>>>>>        Move (Base64Decode(AddressOf(sBase64), &iLen)) to pBase64
36806>>>>>>>        If (not(pBase64)) Begin
36808>>>>>>>            Function_Return ucaBuffer
36809>>>>>>>        End
36809>>>>>>>>
36809>>>>>>>        
36809>>>>>>>        Move (ResizeArray(ucaBuffer, iLen)) to ucaBuffer
36810>>>>>>>        Move (MemCopy(AddressOf(ucaBuffer), pBase64, iLen)) to iLen
36811>>>>>>>        Move (Free(pBase64)) to iLen
36812>>>>>>>        Function_Return ucaBuffer
36813>>>>>>>    End_Function
36814>>>>>>>    
36814>>>>>>>    Function CreatePasswordHashExWithSalt UInteger uiAlgo UChar[] ucaSalt String sPassword String ByRef sHash UInteger uiOptTimeCost Returns Boolean
36816>>>>>>>        Boolean bOk bRequireTimeCost
36816>>>>>>>        UChar[] ucaHash
36817>>>>>>>        
36817>>>>>>>        Case Begin
36817>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36819>>>>>>>                Get CNG_PBKDF2_HMAC "SHA256" (StringToUCharArray(sPassword)) ucaSalt uiOptTimeCost (&ucaHash) False to bOk
36820>>>>>>>                If (not(bOk)) Function_Return False
36823>>>>>>>                
36823>>>>>>>                Move True to bRequireTimeCost
36824>>>>>>>                Case Break
36825>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36828>>>>>>>                Get CNG_PBKDF2_HMAC "SHA512" (StringToUCharArray(sPassword)) ucaSalt uiOptTimeCost (&ucaHash) False to bOk
36829>>>>>>>                If (not(bOk)) Function_Return False
36832>>>>>>>                
36832>>>>>>>                Move True to bRequireTimeCost
36833>>>>>>>                Case Break
36834>>>>>>>            Case Else
36834>>>>>>>                Error 8710 "Invalid algorithm selected."
36835>>>>>>>>
36835>>>>>>>                Function_Return False
36836>>>>>>>        Case End
36836>>>>>>>        
36836>>>>>>>        String sSalt
36836>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36837>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return False
36840>>>>>>>        Get Base64EncodeArr ucaHash to sHash
36841>>>>>>>        If (not(SizeOfString(sHash))) Function_Return False
36844>>>>>>>        
36844>>>>>>>        If (bRequireTimeCost) Begin
36846>>>>>>>            Move (SFormat("%1$%2$%3$%4",            ;                            String(uiAlgo),         ;                            sSalt,                  ;                            String(uiOptTimeCost),  ;                            sHash)) to sHash
36847>>>>>>>        End
36847>>>>>>>>
36847>>>>>>>        Else Begin
36848>>>>>>>            Move (SFormat("%1$%2$%3",               ;                            String(uiAlgo),         ;                            sSalt,                  ;                            sHash)) to sHash
36849>>>>>>>        End
36849>>>>>>>>
36849>>>>>>>        
36849>>>>>>>        Function_Return bOk
36850>>>>>>>    End_Function
36851>>>>>>>    
36851>>>>>>>    Function CreatePasswordHashEx UInteger uiAlgo UInteger uiSaltSize String sPassword String ByRef sHash UInteger uiOptTimeCost Returns Boolean
36853>>>>>>>        UChar[] ucaSalt
36854>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36855>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36858>>>>>>>        
36858>>>>>>>        If (num_arguments > 4) Begin
36860>>>>>>>            Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash, uiOptTimeCost))
36861>>>>>>>        End
36861>>>>>>>>
36861>>>>>>>        Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash))
36862>>>>>>>    End_Function
36863>>>>>>>    
36863>>>>>>>    Function VerifyPasswordHash String sPassword String sHash Returns Boolean
36865>>>>>>>        Boolean bRequiresTimeCost
36865>>>>>>>        UInteger uiAlgo uiTimeCost
36865>>>>>>>        Integer iBegin iEnd
36865>>>>>>>        String sSalt
36865>>>>>>>        
36865>>>>>>>        Move 1 to iBegin
36866>>>>>>>        
36866>>>>>>>        // Parse Algo
36866>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36867>>>>>>>        If (not(iEnd)) Function_Return False
36870>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiAlgo
36871>>>>>>>        
36871>>>>>>>        // Parse Salt
36871>>>>>>>        Move (iEnd + 1) to iBegin
36872>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36873>>>>>>>        If (not(iEnd)) Function_Return False
36876>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to sSalt
36877>>>>>>>        
36877>>>>>>>        Case Begin
36877>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36879>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36882>>>>>>>                Move True to bRequiresTimeCost
36883>>>>>>>                Case Break
36884>>>>>>>            Case Else
36884>>>>>>>                Error 8710 "Invalid algorithm selected."
36885>>>>>>>>
36885>>>>>>>                Function_Return False
36886>>>>>>>        Case End
36886>>>>>>>        
36886>>>>>>>        // Parse optional timecost
36886>>>>>>>        If (bRequiresTimeCost) Begin
36888>>>>>>>            Move (iEnd + 1) to iBegin
36889>>>>>>>            Move (Pos("$", sHash, iBegin)) to iEnd
36890>>>>>>>            If (not(iEnd)) Function_Return False
36893>>>>>>>            Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiTimeCost
36894>>>>>>>        End
36894>>>>>>>>
36894>>>>>>>        
36894>>>>>>>        // Parse rest hash
36894>>>>>>>        Move (iEnd + 1) to iBegin
36895>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36896>>>>>>>        If (iEnd) Function_Return False // inverse check if there are any other errors.
36899>>>>>>>        
36899>>>>>>>        // Base64Decode
36899>>>>>>>        UChar[] ucaSalt
36900>>>>>>>        Get Base64DecodeArr sSalt to ucaSalt
36901>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36904>>>>>>>        
36904>>>>>>>        // Create new hash
36904>>>>>>>        String sNewHash
36904>>>>>>>        If (bRequiresTimeCost) Begin
36906>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash, uiTimeCost))) Begin
36908>>>>>>>                Function_Return False 
36909>>>>>>>            End
36909>>>>>>>>
36909>>>>>>>        End
36909>>>>>>>>
36909>>>>>>>        Else Begin
36910>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash))) Begin
36912>>>>>>>                Function_Return False 
36913>>>>>>>            End
36913>>>>>>>>
36913>>>>>>>        End
36913>>>>>>>>
36913>>>>>>>        Function_Return (sNewHash = sHash)
36914>>>>>>>    End_Function
36915>>>>>>>    
36915>>>>>>>    Function RequiredBufferSizeEx UInteger uiAlgo UInteger uiSaltSize UInteger uiOptTimeCost Returns UBigInt
36917>>>>>>>        Boolean bRequireTimeCost
36917>>>>>>>        UBigInt ullSize
36917>>>>>>>        UChar[] ucaSalt
36918>>>>>>>        String sSalt
36918>>>>>>>        
36918>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36919>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36920>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return 0
36923>>>>>>>        
36923>>>>>>>        Case Begin
36923>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36925>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA256" to ullSize
36926>>>>>>>                Move True to bRequireTimeCost
36927>>>>>>>                Case Break
36928>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36931>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA512" to ullSize
36932>>>>>>>                Move True to bRequireTimeCost
36933>>>>>>>                Case Break
36934>>>>>>>            Case Else
36934>>>>>>>                Error 8710 "Invalid algorithm selected."
36935>>>>>>>>
36935>>>>>>>                Function_Return 0
36936>>>>>>>        Case End
36936>>>>>>>        
36936>>>>>>>        // calculate base64 in a non-floating-manner
36936>>>>>>>        Move (((ullSize + 3 -1) / 3) * 4) to ullSize
36937>>>>>>>        
36937>>>>>>>        Move (ullSize + SizeOfString(String(uiAlgo))) to ullSize
36938>>>>>>>        Move (ullSize + SizeOfString(sSalt)) to ullSize
36939>>>>>>>        If (bRequireTimeCost) Begin
36941>>>>>>>            Move (ullSize + SizeOfString(String(uiOptTimeCost))) to ullSize
36942>>>>>>>            Move (ullSize + 3 /*$*/) to ullSize
36943>>>>>>>        End
36943>>>>>>>>
36943>>>>>>>        Else Begin
36944>>>>>>>            Move (ullSize + 2 /*$*/) to ullSize
36945>>>>>>>        End
36945>>>>>>>>
36945>>>>>>>        
36945>>>>>>>        Function_Return ullSize
36946>>>>>>>    End_Function
36947>>>>>>>End_Class
