37871>>>>>            For i from 0 to iVals
37877>>>>>>
37877>>>>>                If (vValue = ConfigProp.Settings.asOptValues[i]) Begin
37879>>>>>                    Function_Return True
37880>>>>>                End
37880>>>>>>
37880>>>>>            Loop
37881>>>>>>
37881>>>>>        End
37881>>>>>>
37881>>>>>        If (iType = OLE_VT_Bstr) Begin
37883>>>>>            // compare allowed values
