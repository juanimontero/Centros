37867>>>>>                        End
37867>>>>>>
37867>>>>>                        Move (nCur + ConfigProp.Settings.iOptStepSize) to nCur
37868>>>>>                    Loop
37869>>>>>>
37869>>>>>                End
37869>>>>>>
