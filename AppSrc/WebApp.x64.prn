39550>>>Object oSimpleHTTPHandler is a cWebHttpHandler
39552>>>    Set psPath to "Status"
39553>>>    Set psVerbs to "GET"
39554>>>
39554>>>    Procedure OnHttpGet String sPath String sAcceptType
39557>>>        String sCode 
39557>>>        Integer iStatusActual
39557>>>        Get UrlParameter "Code" to sCode
39558>>>  
39558>>>        Case Begin
39558>>>            Case (sCode = "200")
39560>>>                Send SetResponseStatus 200 "OK" 0
39561>>>            Case Break
39562>>>            
39562>>>            Case (sCode = "202")
39565>>>                Send SetResponseStatus 202 "Accepted" 0
39566>>>            Case Break
39567>>>            
39567>>>            Case (sCode = "302")
39570>>>                Send SetResponseStatus 302 "Found" 0
39571>>>            Case Break
39572>>>            
39572>>>            Case (sCode = "307")
39575>>>                Send SetResponseStatus 307 "Temporary Redirect" 0
39576>>>            Case Break
39577>>>            
39577>>>            Case (sCode = "404")
39580>>>                Send SetResponseStatus 404 "Not found" 0
39581>>>            Case Break
39582>>>            
39582>>>            Case (sCode = "406")
39585>>>                Send SetResponseStatus 406 "Not Acceptable" 0
39586>>>            Case Break
39587>>>            
39587>>>            Case (sCode = "500")
39590>>>                Send SetResponseStatus 500 "Internal Servel Error" 0
39591>>>            Case Break
39592>>>            
39592>>>            Case (sCode = "508")
39595>>>                Send SetResponseStatus 508 "Loop detected" 0
39596>>>            Case Break
39597>>>        
39597>>>        
39597>>>        Case End   
39597>>>        
39597>>>    //----
39597>>>        Send AddHttpResponseHeader "Content-Type" "text/html"
39598>>>        Send OutputString '<html>'
39599>>>        Send OutputString '<head><title>Status</title></head>'
39600>>>        Send OutputString (SFormat('<body><h1>Status =  %1!</h1></body>', sCode))
39601>>>        Send OutputString '</html>'
39602>>>        
39602>>>        
39602>>>                
39602>>>    End_Procedure
39603>>>End_Object
