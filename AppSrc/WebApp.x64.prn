38182>>>>>>>>>
38182>>>>>>>>>// these define the three characters that define BOM for utf8.
38182>>>>>>>>>// These serve no purpos and are rarely used. If used they must be removed
38182>>>>>>>>>Define C_BOM1 for |CI$EF
38182>>>>>>>>>Define C_BOM2 for |CI$BB
38182>>>>>>>>>Define C_BOM3 for |CI$BF
38182>>>>>>>>>
38182>>>>>>>>>
38182>>>>>>>>>
38182>>>>>>>>>// define JSON transfer status codes used by peJsonTransferStatus
38182>>>>>>>>>Enum_List
38182>>>>>>>>>    Define jtsOk                 // ok
38182>>>>>>>>>    Define jtsHttpRequestFailed  // the post/get http request returned an error
38182>>>>>>>>>    Define jtsInvalidContentType // response content type not JSON
38182>>>>>>>>>    Define jtsNotJson            // return value not JSON (could not load in object)
38182>>>>>>>>>    Define jtsError              // unspecified return error
38182>>>>>>>>>End_Enum_List
38182>>>>>>>>>
38182>>>>>>>>>
38182>>>>>>>>>Class cJsonHttpTransfer is a cHttpTransfer
38183>>>>>>>>>    
38183>>>>>>>>>    Procedure Construct_Object
38185>>>>>>>>>        Forward Send Construct_object
38187>>>>>>>>>        
38187>>>>>>>>>        Property String  psContentTypeSent "application/json; charset=utf-8"     // default content type for posted data
38188>>>>>>>>>        
38188>>>>>>>>>        Property Boolean pbClearHeaders      True         // should headers always be cleared after a post
38189>>>>>>>>>        
38189>>>>>>>>>        Property UChar[] pucDataReceived                 // maintained by object
38190>>>>>>>>>        
38190>>>>>>>>>        Property String  psContentTypeReceived ''         // content type received
38191>>>>>>>>>        
38191>>>>>>>>>        Property String  psJsonParseError ''              // Set if response JSON can't be parsed
38192>>>>>>>>>        
38192>>>>>>>>>        Property String  psContentTypeExpected 'application/json' // content type received - expected value should be contained in here.
38193>>>>>>>>>        
38193>>>>>>>>>        Property Integer peJsonTransferStatus jtsOk
38194>>>>>>>>>        
38194>>>>>>>>>        // if true, the http post does not happend and whatever was posted is just returned as a copy.
38194>>>>>>>>>        // Good for internal Testing
38194>>>>>>>>>        Property Boolean pbPostLoopTest False
38195>>>>>>>>>        
38195>>>>>>>>>        Set piBufferSize to -1  //  No chunking needed
38196>>>>>>>>>        Set psAcceptTypes to "application/json"
38197>>>>>>>>>    End_Procedure
38198>>>>>>>>>    
38198>>>>>>>>>    // private helper function. Convert data passed by pointer to an JSON document.
38198>>>>>>>>>    // return 0, if error
38198>>>>>>>>>    //
38198>>>>>>>>>    Function UCharDatatoJson UChar[] ucJson Returns Handle
38200>>>>>>>>>        Integer iVoid bOk
38200>>>>>>>>>        Handle hoJson
38200>>>>>>>>>        String sError
38200>>>>>>>>>        Get Create of Desktop (RefClass(cJsonObject)) to hoJson
38201>>>>>>>>>        Get ParseUTF8 of hoJson ucJson to bOk
38202>>>>>>>>>        If not bOk Begin
38204>>>>>>>>>            // store the JSON parse error info
38204>>>>>>>>>            Get psParseError of hoJson to sError
38205>>>>>>>>>            Set psJsonParseError to sError
38206>>>>>>>>>            Send Destroy of hoJson
38207>>>>>>>>>            Move 0 to hoJson
38208>>>>>>>>>        End
38208>>>>>>>>>>
38208>>>>>>>>>        Function_Return hoJson
38209>>>>>>>>>    End_Function
38210>>>>>>>>>    
38210>>>>>>>>>    // Clear pucDataReceived
38210>>>>>>>>>    Procedure ClearDataReceived
38212>>>>>>>>>        UChar[] ucEmpty
38213>>>>>>>>>        
38213>>>>>>>>>        Set pucDataReceived to ucEmpty
38214>>>>>>>>>        Set psJsonParseError to ''
38215>>>>>>>>>    End_Procedure
38216>>>>>>>>>    
38216>>>>>>>>>    // augment to release any memor
38216>>>>>>>>>    Procedure Destroy_Object
38218>>>>>>>>>        Send ClearDataReceived
38219>>>>>>>>>        Forward Send Destroy_object
38221>>>>>>>>>    End_Procedure
38222>>>>>>>>>    
38222>>>>>>>>>    // called during http transfer. Take passed data and append to pucDataReceived.
38222>>>>>>>>>    // If new transfer save contenttype.
38222>>>>>>>>>    Procedure OnDataReceivedUC String sContentType UChar[] ucData
38224>>>>>>>>>        UChar[] ucBuffer
38225>>>>>>>>>        Integer iDataLen
38225>>>>>>>>>        
38225>>>>>>>>>        Move (SizeOfArray(ucData)) to iDataLen
38226>>>>>>>>>        
38226>>>>>>>>>        If (iDataLen > 0) Begin
38228>>>>>>>>>            Get pucDataReceived to ucBuffer
38229>>>>>>>>>            If (SizeOfArray(ucBuffer) > 0) Begin
38231>>>>>>>>>                Set pucDataReceived to (AppendArray(ucBuffer, ucData))
38232>>>>>>>>>            End
38232>>>>>>>>>>
38232>>>>>>>>>            Else Begin
38233>>>>>>>>>                Set psContentTypeReceived to sContentType
38234>>>>>>>>>                
38234>>>>>>>>>                If (iDataLen > 3 and ucData[0]=C_BOM1 and ucData[1]=C_BOM2 and ucData[2]=C_BOM3) Begin
38236>>>>>>>>>                    Set pucDataReceived to (CopyArray(ucData, 3, iDataLen - 1))
38237>>>>>>>>>                End
38237>>>>>>>>>>
38237>>>>>>>>>                Else Begin
38238>>>>>>>>>                    Set pucDataReceived to ucData
38239>>>>>>>>>                End
38239>>>>>>>>>>
38239>>>>>>>>>            End
38239>>>>>>>>>>
38239>>>>>>>>>        End
38239>>>>>>>>>>
38239>>>>>>>>>    End_Procedure
38240>>>>>>>>>    
38240>>>>>>>>>    Function LoopDataBack UChar[] ucData Returns Boolean
38242>>>>>>>>>        Pointer pInData
38242>>>>>>>>>        Boolean bOk
38242>>>>>>>>>        
38242>>>>>>>>>        Set pucDataReceived to ucData
38243>>>>>>>>>        Set psContentTypeReceived to (psContentTypeExpected(Self))
38244>>>>>>>>>        
38244>>>>>>>>>        Function_Return True
38245>>>>>>>>>    End_Function
38246>>>>>>>>>    
38246>>>>>>>>>    
38246>>>>>>>>>    Function HttpVerbJsonAddrExec String sHost String sFilePath Pointer pJson Integer iLen String sVerb  Returns Boolean
38248>>>>>>>>>        Boolean bOk
38248>>>>>>>>>        Integer iError
38248>>>>>>>>>        String sContentType
38248>>>>>>>>>        
38248>>>>>>>>>        Send ClearDataReceived  // this should be zero, just in case it is not
38249>>>>>>>>>        Set psRemoteHost to sHost
38250>>>>>>>>>        
38250>>>>>>>>>        Get psContentTypeSent to sContentType
38251>>>>>>>>>        If (iLen > 0 and sContentType <> "") Begin
38253>>>>>>>>>            Get AddHeader "Content-Type" sContentType to bok
38254>>>>>>>>>        End
38254>>>>>>>>>>
38254>>>>>>>>>        Get HttpVerbAddrRequest sFilePath pJson iLen False sVerb to bOK
38255>>>>>>>>>        
38255>>>>>>>>>        // You need to clear headers between posts. If you need to set custom headers you should
38255>>>>>>>>>        // set pbClearHeaders to false and then manually send ClearHeaders and AddHeaders in your code
38255>>>>>>>>>        If (pbClearHeaders(Self)) ;            Send ClearHeaders
38258>>>>>>>>>        
38258>>>>>>>>>        
38258>>>>>>>>>        Function_Return bOk
38259>>>>>>>>>    End_Function
38260>>>>>>>>>    
38260>>>>>>>>>    // We assume but do not verify that the data in ucJson is actually UTF8 JSON
38260>>>>>>>>>    Function HttpVerbJsonUChar String sHost String sFilePath UChar[] ucJson String sVerb Returns UChar[]
38262>>>>>>>>>        Integer iLen
38262>>>>>>>>>        Boolean bOk
38262>>>>>>>>>        UChar[] ucJsonReceived
38263>>>>>>>>>        String sContentTypeReceived sContentTypeExpected
38263>>>>>>>>>        
38263>>>>>>>>>        Move (SizeOfArray(ucJson)) to iLen
38264>>>>>>>>>        
38264>>>>>>>>>        If (pbPostLoopTest(Self)) Begin
38266>>>>>>>>>            Get LoopDataBack ucJson to bOk
38267>>>>>>>>>        End
38267>>>>>>>>>>
38267>>>>>>>>>        Else Begin
38268>>>>>>>>>            Get HttpVerbJsonAddrExec sHost sFilePath (AddressOf(ucJson)) iLen sVerb to bOk
38269>>>>>>>>>        End
38269>>>>>>>>>>
38269>>>>>>>>>                
38269>>>>>>>>>        If bOk Begin
38271>>>>>>>>>            Set peJsonTransferStatus to jtsOk
38272>>>>>>>>>            Get pucDataReceived to ucJsonReceived
38273>>>>>>>>>            
38273>>>>>>>>>            If (SizeOfArray(ucJsonReceived) > 0) Begin
38275>>>>>>>>>                // we have data, check that the content type is ok. This is as far
38275>>>>>>>>>                // as we can go here.
38275>>>>>>>>>                Get psContentTypeReceived to sContentTypeReceived
38276>>>>>>>>>                Get psContentTypeExpected to sContentTypeExpected
38277>>>>>>>>>                // If contentType expected is empty, we allow anything
38277>>>>>>>>>                If (sContentTypeExpected<>"" and pos(lowercase(sContentTypeExpected),lowercase(sContentTypeReceived))=0) Begin
38279>>>>>>>>>                    Set peJsonTransferStatus to jtsInvalidContentType
38280>>>>>>>>>                End
38280>>>>>>>>>>
38280>>>>>>>>>            End
38280>>>>>>>>>>
38280>>>>>>>>>        End
38280>>>>>>>>>>
38280>>>>>>>>>        Else Begin
38281>>>>>>>>>            Set peJsonTransferStatus to jtsHttpRequestFailed
38282>>>>>>>>>        End
38282>>>>>>>>>>
38282>>>>>>>>>                
38282>>>>>>>>>        Function_Return ucJsonReceived
38283>>>>>>>>>    End_Function
38284>>>>>>>>>    
38284>>>>>>>>>    // Generic HTTP Request - it is passed the Verb. Used by all other http requests
38284>>>>>>>>>    Function HttpVerbJson  String sHost String sFilePath Handle  hoJsonRequest String sVerb Boolean ByRef bOk Returns Handle
38286>>>>>>>>>        UChar[] ucJsonRequest ucJsonResponse
38288>>>>>>>>>        Handle hoJsonResponse
38288>>>>>>>>>        Integer eStat
38288>>>>>>>>>        
38288>>>>>>>>>        If (hoJsonRequest<>0) Begin
38290>>>>>>>>>            Get StringifyUTF8 of hoJsonRequest to ucJsonRequest
38291>>>>>>>>>        End
38291>>>>>>>>>>
38291>>>>>>>>>        
38291>>>>>>>>>        Get HttpVerbJsonUChar sHost sFilePath ucJsonRequest sVerb to ucJsonResponse
38292>>>>>>>>>        
38292>>>>>>>>>        If (SizeOfArray(ucJsonResponse)) Begin
38294>>>>>>>>>            Get UCharDatatoJson ucJsonResponse to hoJsonResponse
38295>>>>>>>>>            If (hoJsonResponse=0) Begin
38297>>>>>>>>>                // this indicates that data was returned but it could not be loaded as Json
38297>>>>>>>>>                Set peJsonTransferStatus to jtsNotJson
38298>>>>>>>>>                // note bad data is still is ppDataReceived (might be useful for debugging)
38298>>>>>>>>>            End
38298>>>>>>>>>>
38298>>>>>>>>>        End
38298>>>>>>>>>>
38298>>>>>>>>>        
38298>>>>>>>>>        // return Ok status by reference
38298>>>>>>>>>        Get peJsonTransferStatus to eStat
38299>>>>>>>>>        Move (eStat=jtsOk) to bOk
38300>>>>>>>>>        
38300>>>>>>>>>        Function_Return hoJsonResponse
38301>>>>>>>>>    End_Function
38302>>>>>>>>>    
38302>>>>>>>>>    Function HttpPostJson String sHost String sFilePath Handle hoJsonRequest Boolean ByRef bOk Returns Handle
38304>>>>>>>>>        Handle hoJson
38304>>>>>>>>>        Get HttpVerbJson sHost sFilePath hoJsonRequest "POST" (&bOk) to hoJson
38305>>>>>>>>>        Function_Return hoJson
38306>>>>>>>>>    End_Function
38307>>>>>>>>>    
38307>>>>>>>>>    Function HttpGetJson String sHost String sFilePath Boolean ByRef bOk Returns Handle
38309>>>>>>>>>        Pointer pJson
38309>>>>>>>>>        Integer iVoid iLen
38309>>>>>>>>>        Handle hoJson
38309>>>>>>>>>        Get HttpVerbJson sHost sFilePath 0 "GET" (&bOk) to hoJson
38310>>>>>>>>>        Function_Return hoJson
38311>>>>>>>>>    End_Function
38312>>>>>>>>>    
