38866>>>                    Get HasRecord of oAlumnos_DD to bHasRecord
38867>>>                    
38867>>>                    If bHasRecord Begin
38869>>>                        Send SetBreadCrumbCaption (Trim(Alumnos.Nombre +" "+ Alumnos.Apellidos))
38870>>>                        Send SetHeaderCaption (Trim(Alumnos.Nombre +" "+ Alumnos.Apellidos))
38871>>>                    End
38871>>>>
38871>>>                Case Break
38872>>>
38872>>>            Case (NavigateData.eNavigateType = nfFromParent)
38875>>>                // If from parent, this is a constrained drill down.
38875>>>                Case Break
38876>>>
38876>>>            Case (NavigateData.eNavigateType = nfFromChild)
38879>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38879>>>                Case Break
38880>>>
38880>>>            Case Else // must be nfUndefined
38880>>>
38880>>>        Case End
38880>>>
38880>>>        Send SetActionButtons
