38200>>>>>>>>>Class cJsonHttpTransfer is a cHttpTransfer
38201>>>>>>>>>    
38201>>>>>>>>>    Procedure Construct_Object
38203>>>>>>>>>        Forward Send Construct_object
38205>>>>>>>>>        
38205>>>>>>>>>        Property String  psContentTypeSent "application/json; charset=utf-8"     // default content type for posted data
38206>>>>>>>>>        
38206>>>>>>>>>        Property Boolean pbClearHeaders      True         // should headers always be cleared after a post
38207>>>>>>>>>        
38207>>>>>>>>>        Property UChar[] pucDataReceived                 // maintained by object
38208>>>>>>>>>        
38208>>>>>>>>>        Property String  psContentTypeReceived ''         // content type received
38209>>>>>>>>>        
38209>>>>>>>>>        Property String  psJsonParseError ''              // Set if response JSON can't be parsed
38210>>>>>>>>>        
38210>>>>>>>>>        Property String  psContentTypeExpected 'application/json' // content type received - expected value should be contained in here.
38211>>>>>>>>>        
38211>>>>>>>>>        Property Integer peJsonTransferStatus jtsOk
38212>>>>>>>>>        
38212>>>>>>>>>        // if true, the http post does not happend and whatever was posted is just returned as a copy.
38212>>>>>>>>>        // Good for internal Testing
38212>>>>>>>>>        Property Boolean pbPostLoopTest False
38213>>>>>>>>>        
38213>>>>>>>>>        Set piBufferSize to -1  //  No chunking needed
38214>>>>>>>>>        Set psAcceptTypes to "application/json"
38215>>>>>>>>>    End_Procedure
38216>>>>>>>>>    
38216>>>>>>>>>    // private helper function. Convert data passed by pointer to an JSON document.
38216>>>>>>>>>    // return 0, if error
38216>>>>>>>>>    //
38216>>>>>>>>>    Function UCharDatatoJson UChar[] ucJson Returns Handle
38218>>>>>>>>>        Integer iVoid bOk
38218>>>>>>>>>        Handle hoJson
38218>>>>>>>>>        String sError
38218>>>>>>>>>        Get Create of Desktop (RefClass(cJsonObject)) to hoJson
38219>>>>>>>>>        Get ParseUTF8 of hoJson ucJson to bOk
38220>>>>>>>>>        If not bOk Begin
38222>>>>>>>>>            // store the JSON parse error info
38222>>>>>>>>>            Get psParseError of hoJson to sError
38223>>>>>>>>>            Set psJsonParseError to sError
38224>>>>>>>>>            Send Destroy of hoJson
38225>>>>>>>>>            Move 0 to hoJson
38226>>>>>>>>>        End
38226>>>>>>>>>>
38226>>>>>>>>>        Function_Return hoJson
38227>>>>>>>>>    End_Function
38228>>>>>>>>>    
38228>>>>>>>>>    // Clear pucDataReceived
38228>>>>>>>>>    Procedure ClearDataReceived
38230>>>>>>>>>        UChar[] ucEmpty
38231>>>>>>>>>        
38231>>>>>>>>>        Set pucDataReceived to ucEmpty
38232>>>>>>>>>        Set psJsonParseError to ''
38233>>>>>>>>>    End_Procedure
38234>>>>>>>>>    
38234>>>>>>>>>    // augment to release any memor
38234>>>>>>>>>    Procedure Destroy_Object
38236>>>>>>>>>        Send ClearDataReceived
38237>>>>>>>>>        Forward Send Destroy_object
38239>>>>>>>>>    End_Procedure
38240>>>>>>>>>    
38240>>>>>>>>>    // called during http transfer. Take passed data and append to pucDataReceived.
38240>>>>>>>>>    // If new transfer save contenttype.
38240>>>>>>>>>    Procedure OnDataReceivedUC String sContentType UChar[] ucData
38242>>>>>>>>>        UChar[] ucBuffer
38243>>>>>>>>>        Integer iDataLen
38243>>>>>>>>>        
38243>>>>>>>>>        Move (SizeOfArray(ucData)) to iDataLen
38244>>>>>>>>>        
38244>>>>>>>>>        If (iDataLen > 0) Begin
38246>>>>>>>>>            Get pucDataReceived to ucBuffer
38247>>>>>>>>>            If (SizeOfArray(ucBuffer) > 0) Begin
38249>>>>>>>>>                Set pucDataReceived to (AppendArray(ucBuffer, ucData))
38250>>>>>>>>>            End
38250>>>>>>>>>>
38250>>>>>>>>>            Else Begin
38251>>>>>>>>>                Set psContentTypeReceived to sContentType
38252>>>>>>>>>                
38252>>>>>>>>>                If (iDataLen > 3 and ucData[0]=C_BOM1 and ucData[1]=C_BOM2 and ucData[2]=C_BOM3) Begin
38254>>>>>>>>>                    Set pucDataReceived to (CopyArray(ucData, 3, iDataLen - 1))
38255>>>>>>>>>                End
38255>>>>>>>>>>
38255>>>>>>>>>                Else Begin
38256>>>>>>>>>                    Set pucDataReceived to ucData
38257>>>>>>>>>                End
38257>>>>>>>>>>
38257>>>>>>>>>            End
38257>>>>>>>>>>
38257>>>>>>>>>        End
38257>>>>>>>>>>
38257>>>>>>>>>    End_Procedure
38258>>>>>>>>>    
38258>>>>>>>>>    Function LoopDataBack UChar[] ucData Returns Boolean
38260>>>>>>>>>        Pointer pInData
38260>>>>>>>>>        Boolean bOk
38260>>>>>>>>>        
38260>>>>>>>>>        Set pucDataReceived to ucData
38261>>>>>>>>>        Set psContentTypeReceived to (psContentTypeExpected(Self))
38262>>>>>>>>>        
38262>>>>>>>>>        Function_Return True
38263>>>>>>>>>    End_Function
38264>>>>>>>>>    
38264>>>>>>>>>    
38264>>>>>>>>>    Function HttpVerbJsonAddrExec String sHost String sFilePath Pointer pJson Integer iLen String sVerb  Returns Boolean
38266>>>>>>>>>        Boolean bOk
38266>>>>>>>>>        Integer iError
38266>>>>>>>>>        String sContentType
38266>>>>>>>>>        
38266>>>>>>>>>        Send ClearDataReceived  // this should be zero, just in case it is not
38267>>>>>>>>>        Set psRemoteHost to sHost
38268>>>>>>>>>        
38268>>>>>>>>>        Get psContentTypeSent to sContentType
38269>>>>>>>>>        If (iLen > 0 and sContentType <> "") Begin
38271>>>>>>>>>            Get AddHeader "Content-Type" sContentType to bok
38272>>>>>>>>>        End
38272>>>>>>>>>>
38272>>>>>>>>>        Get HttpVerbAddrRequest sFilePath pJson iLen False sVerb to bOK
38273>>>>>>>>>        
38273>>>>>>>>>        // You need to clear headers between posts. If you need to set custom headers you should
38273>>>>>>>>>        // set pbClearHeaders to false and then manually send ClearHeaders and AddHeaders in your code
38273>>>>>>>>>        If (pbClearHeaders(Self)) ;            Send ClearHeaders
38276>>>>>>>>>        
38276>>>>>>>>>        
38276>>>>>>>>>        Function_Return bOk
38277>>>>>>>>>    End_Function
38278>>>>>>>>>    
38278>>>>>>>>>    // We assume but do not verify that the data in ucJson is actually UTF8 JSON
38278>>>>>>>>>    Function HttpVerbJsonUChar String sHost String sFilePath UChar[] ucJson String sVerb Returns UChar[]
38280>>>>>>>>>        Integer iLen
38280>>>>>>>>>        Boolean bOk
38280>>>>>>>>>        UChar[] ucJsonReceived
38281>>>>>>>>>        String sContentTypeReceived sContentTypeExpected
38281>>>>>>>>>        
38281>>>>>>>>>        Move (SizeOfArray(ucJson)) to iLen
38282>>>>>>>>>        
38282>>>>>>>>>        If (pbPostLoopTest(Self)) Begin
38284>>>>>>>>>            Get LoopDataBack ucJson to bOk
38285>>>>>>>>>        End
38285>>>>>>>>>>
38285>>>>>>>>>        Else Begin
38286>>>>>>>>>            Get HttpVerbJsonAddrExec sHost sFilePath (AddressOf(ucJson)) iLen sVerb to bOk
38287>>>>>>>>>        End
38287>>>>>>>>>>
38287>>>>>>>>>                
38287>>>>>>>>>        If bOk Begin
38289>>>>>>>>>            Set peJsonTransferStatus to jtsOk
38290>>>>>>>>>            Get pucDataReceived to ucJsonReceived
38291>>>>>>>>>            
38291>>>>>>>>>            If (SizeOfArray(ucJsonReceived) > 0) Begin
38293>>>>>>>>>                // we have data, check that the content type is ok. This is as far
38293>>>>>>>>>                // as we can go here.
38293>>>>>>>>>                Get psContentTypeReceived to sContentTypeReceived
38294>>>>>>>>>                Get psContentTypeExpected to sContentTypeExpected
38295>>>>>>>>>                // If contentType expected is empty, we allow anything
38295>>>>>>>>>                If (sContentTypeExpected<>"" and pos(lowercase(sContentTypeExpected),lowercase(sContentTypeReceived))=0) Begin
38297>>>>>>>>>                    Set peJsonTransferStatus to jtsInvalidContentType
38298>>>>>>>>>                End
38298>>>>>>>>>>
38298>>>>>>>>>            End
38298>>>>>>>>>>
38298>>>>>>>>>        End
38298>>>>>>>>>>
38298>>>>>>>>>        Else Begin
38299>>>>>>>>>            Set peJsonTransferStatus to jtsHttpRequestFailed
38300>>>>>>>>>        End
38300>>>>>>>>>>
38300>>>>>>>>>                
38300>>>>>>>>>        Function_Return ucJsonReceived
38301>>>>>>>>>    End_Function
38302>>>>>>>>>    
38302>>>>>>>>>    // Generic HTTP Request - it is passed the Verb. Used by all other http requests
38302>>>>>>>>>    Function HttpVerbJson  String sHost String sFilePath Handle  hoJsonRequest String sVerb Boolean ByRef bOk Returns Handle
38304>>>>>>>>>        UChar[] ucJsonRequest ucJsonResponse
38306>>>>>>>>>        Handle hoJsonResponse
38306>>>>>>>>>        Integer eStat
38306>>>>>>>>>        
38306>>>>>>>>>        If (hoJsonRequest<>0) Begin
38308>>>>>>>>>            Get StringifyUTF8 of hoJsonRequest to ucJsonRequest
38309>>>>>>>>>        End
38309>>>>>>>>>>
38309>>>>>>>>>        
38309>>>>>>>>>        Get HttpVerbJsonUChar sHost sFilePath ucJsonRequest sVerb to ucJsonResponse
38310>>>>>>>>>        
38310>>>>>>>>>        If (SizeOfArray(ucJsonResponse)) Begin
38312>>>>>>>>>            Get UCharDatatoJson ucJsonResponse to hoJsonResponse
38313>>>>>>>>>            If (hoJsonResponse=0) Begin
38315>>>>>>>>>                // this indicates that data was returned but it could not be loaded as Json
38315>>>>>>>>>                Set peJsonTransferStatus to jtsNotJson
38316>>>>>>>>>                // note bad data is still is ppDataReceived (might be useful for debugging)
38316>>>>>>>>>            End
38316>>>>>>>>>>
38316>>>>>>>>>        End
38316>>>>>>>>>>
38316>>>>>>>>>        
38316>>>>>>>>>        // return Ok status by reference
38316>>>>>>>>>        Get peJsonTransferStatus to eStat
38317>>>>>>>>>        Move (eStat=jtsOk) to bOk
38318>>>>>>>>>        
38318>>>>>>>>>        Function_Return hoJsonResponse
38319>>>>>>>>>    End_Function
38320>>>>>>>>>    
38320>>>>>>>>>    Function HttpPostJson String sHost String sFilePath Handle hoJsonRequest Boolean ByRef bOk Returns Handle
38322>>>>>>>>>        Handle hoJson
38322>>>>>>>>>        Get HttpVerbJson sHost sFilePath hoJsonRequest "POST" (&bOk) to hoJson
38323>>>>>>>>>        Function_Return hoJson
38324>>>>>>>>>    End_Function
38325>>>>>>>>>    
38325>>>>>>>>>    Function HttpGetJson String sHost String sFilePath Boolean ByRef bOk Returns Handle
38327>>>>>>>>>        Pointer pJson
38327>>>>>>>>>        Integer iVoid iLen
38327>>>>>>>>>        Handle hoJson
38327>>>>>>>>>        Get HttpVerbJson sHost sFilePath 0 "GET" (&bOk) to hoJson
38328>>>>>>>>>        Function_Return hoJson
38329>>>>>>>>>    End_Function
38330>>>>>>>>>    
38330>>>>>>>>>    Function HttpPutJson String sHost String sFilePath Handle hoJsonRequest Boolean ByRef bOk Returns Handle
38332>>>>>>>>>        Handle hoJson
38332>>>>>>>>>        Get HttpVerbJson sHost sFilePath hoJsonRequest "PUT" (&bOk) to hoJson
38333>>>>>>>>>        Function_Return hoJson
38334>>>>>>>>>    End_Function
38335>>>>>>>>>    
38335>>>>>>>>>    Function HttpDeleteJson String sHost String sFilePath Handle hoJsonRequest Boolean ByRef bOk Returns Handle
38337>>>>>>>>>        Handle hoJson
38337>>>>>>>>>        Get HttpVerbJson sHost sFilePath hoJsonRequest "DELETE" (&bOk) to hoJson
38338>>>>>>>>>        Function_Return hoJson
38339>>>>>>>>>    End_Function
38340>>>>>>>>>    
38340>>>>>>>>>    Function HttpPatchJson  String sHost String sFilePath Handle hoJsonRequest Boolean ByRef bOk Returns Handle
38342>>>>>>>>>        Handle hoJson
38342>>>>>>>>>        Get HttpVerbJson sHost sFilePath hoJsonRequest "PATCH" (&bOk) to hoJson
38343>>>>>>>>>        Function_Return hoJson
38344>>>>>>>>>    End_Function
38345>>>>>>>>>    
38345>>>>>>>>>    // After an Json xfer request this message can be sent to display an error message if one occurred.
38345>>>>>>>>>    // Normally you would first check peJsonTransferStatus to see if it is not jtsOk. If not, send
38345>>>>>>>>>    // LastError to see the error
38345>>>>>>>>>    
38345>>>>>>>>>    // return last JSON transfer error text
38345>>>>>>>>>    Function TransferErrorDescription Returns String
38347>>>>>>>>>        String  sError sJsonError
38347>>>>>>>>>        Integer eJsonTransferStatus
38347>>>>>>>>>        Get peJsonTransferStatus to eJsonTransferStatus
38348>>>>>>>>>        Get psJsonParseError to sJsonError
38349>>>>>>>>>        Case Begin
38349>>>>>>>>>            Case (eJsonTransferStatus=jtsOk) ;                Move '' to sError
38352>>>>>>>>>            Case (eJsonTransferStatus=jtsHttpRequestFailed) ;                Move C_$HttpRequestFailed to sError
38356>>>>>>>>>            Case (eJsonTransferStatus=jtsInvalidContentType) ;                Move (SFormat(C_$InvalidContentTypeReceived,psContentTypeReceived(Self))) to sError
38360>>>>>>>>>            Case (eJsonTransferStatus=jtsNotJson) ;                Move (C_$ReceivedDataNotInJsonFormat * sJsonError) to sError
38364>>>>>>>>>            Case Else ;                Move C_$ReceivedDataIsBad to sError
38366>>>>>>>>>        Case End
38366>>>>>>>>>        Function_Return sError
38367>>>>>>>>>    End_Function
38368>>>>>>>>>    
38368>>>>>>>>>    // can be send to raise an error.
38368>>>>>>>>>    Procedure LastError
38370>>>>>>>>>        Integer eJsonTransferStatus
38370>>>>>>>>>        String sError
38370>>>>>>>>>        
38370>>>>>>>>>        Get peJsonTransferStatus to eJsonTransferStatus
38371>>>>>>>>>        If (eJsonTransferStatus<>jtsOk) Begin
38373>>>>>>>>>            Get TransferErrorDescription to sError
38374>>>>>>>>>            Error DFERR_JSON_HTTP sError
38375>>>>>>>>>>
38375>>>>>>>>>        End
38375>>>>>>>>>>
38375>>>>>>>>>    End_Procedure
38376>>>>>>>>>    
38376>>>>>>>>>    
38376>>>>>>>>>End_Class
