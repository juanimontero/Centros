36738>>>>>>>        Get CNG_PBKDF2_HMAC_BufferSizeEx hoProv to uiHashLen
36739>>>>>>>        
36739>>>>>>>        Move (CNG_BCryptCloseAlgorithmProvider(hoProv, 0)) to iErr
36740>>>>>>>        
36740>>>>>>>        Function_Return uiHashLen
36741>>>>>>>    End_Function
36742>>>>>>>    
36742>>>>>>>    Function CNG_PBKDF2_HMAC    WString wsAlgo ;                                UChar[] ucaData ;                                UChar[] ucaSalt ;                                UInteger uiTimeCost ;                                UChar[] ByRef ucaHashOut ;                                Boolean bOptThrow ;                                Returns Boolean
36744>>>>>>>        Integer iErr iHashLen
36744>>>>>>>        
36744>>>>>>>        // Handle Optionals
36744>>>>>>>        // First the optional throwing of errors.
36744>>>>>>>        Boolean bThrow
36744>>>>>>>        Move True to bThrow
36745>>>>>>>        If (num_arguments > 4) Move bOptThrow to bThrow
36748>>>>>>>        
36748>>>>>>>        // Open the algorithm.
36748>>>>>>>        Handle hoProv
36748>>>>>>>        Move (CNG_BCryptOpenAlgorithmProvider(AddressOf(hoProv), AddressOf(wsAlgo), 0, |CI$00000008 /*BCRYPT_ALG_HANDLE_HMAC_FLAG*/)) to iErr
36749>>>>>>>        If (iErr) Begin
36751>>>>>>>            If (bThrow) Error 8710 "Failed to open up the algo provider."
36754>>>>>>>            Function_Return False
36755>>>>>>>        End
36755>>>>>>>>
36755>>>>>>>        
36755>>>>>>>        Get CNG_PBKDF2_HMAC_BufferSizeEx hoProv to iHashLen
36756>>>>>>>        If (not(iHashLen)) Begin
36758>>>>>>>            If (bThrow) Error 8710 "Failed to get expected length of hash."
36761>>>>>>>            Function_Return False
36762>>>>>>>        End
36762>>>>>>>>
36762>>>>>>>        
36762>>>>>>>        // Resize buffers to the expected output.
36762>>>>>>>        Move (ResizeArray(ucaHashOut, iHashLen)) to ucaHashOut
36763>>>>>>>        
36763>>>>>>>        Move (CNG_BCryptDeriveKeyPBKDF2(hoProv, AddressOf(ucaData), SizeOfArray(ucaData), AddressOf(ucaSalt), SizeOfArray(ucaSalt), uiTimeCost, AddressOf(ucaHashOut), SizeOfArray(ucaHashOut), 0)) to iErr
36764>>>>>>>        If (iErr) Begin
36766>>>>>>>            Move (CNG_BCryptCloseAlgorithmProvider(hoProv, 0)) to iErr
36767>>>>>>>            If (bThrow) Error 8710 "Failed to create hash."
36770>>>>>>>            Function_Return False
36771>>>>>>>        End
36771>>>>>>>>
36771>>>>>>>        
36771>>>>>>>        Move (CNG_BCryptCloseAlgorithmProvider(hoProv, 0)) to iErr
36772>>>>>>>        If (iErr) Begin
36774>>>>>>>            If (bThrow) Error 8710 "Failed to close algo provider."
36777>>>>>>>            Function_Return False
36778>>>>>>>        End
36778>>>>>>>>
36778>>>>>>>        
36778>>>>>>>        Function_Return True
36779>>>>>>>    End_Function
36780>>>>>>>End_Class
