37855>>>>>            // compare min, max and allowed vals
37855>>>>>            If (vValue >= ConfigProp.Settings.iOptMinValue and vValue =< ConfigProp.Settings.iOptMaxValue) Begin
37857>>>>>                // check step size
37857>>>>>                If (ConfigProp.Settings.iOptStepSize > 0) Begin
37859>>>>>                    Move ConfigProp.Settings.iOptMinValue to nCur
37860>>>>>                    While (nCur <= ConfigProp.Settings.iOptMaxValue)
37864>>>>>                        If (vValue = nCur) Begin
