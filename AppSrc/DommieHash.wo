Use cWebView.pkg
Use cWebPanel.pkg
Use cWebForm.pkg 
Use cWebGroup.pkg
Use cWebMenuGroup.pkg 
Use cWebMenuItem.pkg

Use zTelefonoiValidation.pkg

Object oDummieHash is a cWebView

    // Your DDO structure will go here
    Set piWidth to 700
    Set psCaption to "Dummie Hash"

    // Your DDO structure will go here

    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12

        Object oForm_Contrasenna is a cWebForm
            Set piColumnSpan to 3
            Set psLabel to "Contraseña"
            Set peLabelPosition to lpTop
        End_Object
        
        // place controls here
        // Your view will grow as controls are added
        
        Object oForm_Hash is a cWebForm
            Set piColumnSpan to 9
            Set psLabel to "Vuelta Hash"
            Set piColumnIndex to 3
            Set peLabelPosition to lpTop
            Set pbRequired to False
            Set pbReadOnly to True
        End_Object

        Object oWebLabel_sMsg_Err is a cWebLabel
            Set psCaption to ""
            Set piColumnIndex to 0
            Set piColumnSpan to 12
        End_Object

        Object oWebSpacer1 is a cWebSpacer
            Set piColumnSpan to 12
        End_Object

        Object oValidationButton is a cWebButton
            Set piColumnSpan to 6
            Set psCaption to "Crear"
            Set piColumnIndex to 3
        
            Procedure OnClick
                Boolean bRet
                String sContrasenna sPassword
                WebGet psValue of oForm_Contrasenna to sContrasenna
   
                Get CreatePasswordHash of ghoWebSessionManager sContrasenna (&sPassword) to bRet
                
                WebSet psBackgroundColor of oForm_Contrasenna to "#ffffff"
                WebSet psCaption of oWebLabel_sMsg_Err to ""
                
                If (bRet) Begin
                    WebSet psBackgroundColor of oForm_Contrasenna to "green"
                    WebSet psBackgroundColor of oForm_Hash to "green"
                    WebSet psValue of oForm_Hash to sPassword

                    
                    
                    
                End
                If (not (bRet)) Begin
                    WebSet psBackgroundColor of oForm_Contrasenna to "red"
                    WebSet psBackgroundColor of oForm_Hash to "red"
                    WebSet psCaption of oWebLabel_sMsg_Err to sPassword
                End
                
                
            End_Procedure
        End_Object
        
    End_Object



End_Object
